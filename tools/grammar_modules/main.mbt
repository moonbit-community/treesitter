// Generator for the grammar modules under grammars/ (driven by
// tools/grammars/update.py; see tools/grammars/update.sh).
//
//   grammar_modules emit <grammar.json> <out.mbt> <identifier> <version> <node-types.json> <label>
//       Generate the language tables from grammar.json with the MoonBit
//       generator (`version`, `major.minor.patch` or `-`, is the grammar's
//       version from tree-sitter.json, which `tree-sitter generate` stores as
//       the language metadata) and write them to out.mbt as
//       `let <identifier> : String` in the compact base64 format of
//       `@language.Language::from_compact_base64`; write the generated
//       node-types.json. `label` names grammar.json in the header comment of
//       out.mbt. Print the grammar's name, external token count and
//       whether `@scanners.scanner_for` has its external scanner, as JSON.
//   grammar_modules dump <file.mbt> <out.json>
//       Decode the tables embedded in a file written by `emit` and write the
//       Language as JSON (the format of `src/language.json`).
//   grammar_modules bench <language.json>...
//       Compare the JSON and the compact encodings: sizes, decoding time.

///|
/// Characters of base64 per line of the multi-line string literal (a multiple
/// of 4, so that every line decodes on its own).
let line_width : Int = 96

///|
fn parse_version(text : String) -> (Int, Int, Int)? raise {
  if text == "-" {
    return None
  }
  let parts = []
  for p in text.split(".") {
    parts.push(@string.parse_int(p))
  }
  guard parts is [major, minor, patch] else { fail("invalid version \{text}") }
  Some((major, minor, patch))
}

///|
fn render_tables(identifier : String, text : String, source : String) -> String {
  let sb = StringBuilder(size_hint=text.length() * 105 / 100 + 400)
  sb.write_string(
    (
      $|// Generated by tools/grammars/update.sh from \{source}. Do not edit.
      $|
      $|///|
      $|/// The language tables in the compact format of
      $|/// `@language.Language::from_compact_base64`.
      $|let \{identifier} : String =
      $|
    ),
  )
  let mut i = 0
  while i < text.length() {
    let end = if i + line_width < text.length() {
      i + line_width
    } else {
      text.length()
    }
    sb.write_string("  #|")
    sb.write_string(text.unsafe_substring(start=i, end~))
    sb.write_char('\n')
    i = end
  }
  sb.to_string()
}

///|
/// The base64 text of a file written by `emit`: the contents of its `#|`
/// lines.
fn extract_tables(source : String) -> String {
  let sb = StringBuilder()
  for line in source.split("\n") {
    let line = line.trim_start(chars=" ")
    if line.has_prefix("#|") {
      sb.write_stringview(line[2:])
    }
  }
  sb.to_string()
}

///|
async fn emit(args : ArrayView[String]) -> Unit {
  guard args
    is [grammar_path, out_path, identifier, version, node_types_path, label] else {
    fail(
      "usage: emit <grammar.json> <out.mbt> <identifier> <version> <node-types.json> <label>",
    )
  }
  let grammar_json = @fs.read_file(grammar_path).text()
  let semantic_version = parse_version(version)
  let generated = match semantic_version {
    Some(v) =>
      @generate.generate_from_grammar_json(grammar_json, semantic_version=v)
    None => @generate.generate_from_grammar_json(grammar_json)
  }
  let text = generated.language.to_compact_base64()
  // Check the round trip before writing anything.
  guard @language.Language::from_compact_base64(text) == generated.language else {
    fail("compact round trip failed for \{grammar_path}")
  }
  @fs.write_file(
    out_path,
    render_tables(identifier, text, label),
    create_mode=CreateOrTruncate,
  )
  @fs.write_file(
    node_types_path,
    generated.node_types_json,
    create_mode=CreateOrTruncate,
  )
  let language = generated.language
  let info : Json = {
    "name": language.name,
    "external_token_count": language.external_token_count,
    "scanner": @scanners.scanner_for(language.name) is Some(_),
  }
  println(info.stringify())
}

///|
async fn dump(args : ArrayView[String]) -> Unit {
  guard args is [source_path, out_path] else {
    fail("usage: dump <file.mbt> <out.json>")
  }
  let source = @fs.read_file(source_path).text()
  let language = @language.Language::from_compact_base64(extract_tables(source))
  @fs.write_file(
    out_path,
    language.to_json().stringify(),
    create_mode=CreateOrTruncate,
  )
}

///|
async fn bench(paths : ArrayView[String]) -> Unit {
  println(
    "language\tjson_bytes\tcompact_bytes\tbase64_chars\tjson_decode_ms\tcompact_decode_ms\tencode_ms",
  )
  for path in paths {
    let json_text = @fs.read_file(path).text()
    let t0 = @env.now()
    let language : @language.Language = @json.from_json(@json.parse(json_text))
    let t1 = @env.now()
    let compact = language.to_compact()
    let text = @language.Language::from_compact_base64(
      language.to_compact_base64(),
    )
    let t2 = @env.now()
    guard text == language else { fail("round trip failed for \{path}") }
    let base64 = language.to_compact_base64()
    let runs = 5
    let t3 = @env.now()
    for _ in 0..<runs {
      ignore(@language.Language::from_compact_base64(base64))
    }
    let t4 = @env.now()
    let name = path.split("/").last().unwrap().to_owned()
    println(
      "\{name}\t\{@utf8.encode(json_text).length()}\t\{compact.length()}\t\{base64.length()}\t\{t1 - t0}\t\{(t4 - t3) / runs.to_uint64()}\t\{t2 - t1}",
    )
  }
}

///|
async fn main {
  let args = @env.args()
  guard args.length() >= 2 else {
    println("usage: grammar_modules emit|dump|bench ...")
    return
  }
  let rest = args[2:]
  match args[1] {
    "emit" => emit(rest)
    "dump" => dump(rest)
    "bench" => bench(rest)
    command => fail("unknown command \{command}")
  }
}
