    "zeta": {"type": "SEQ", "members": [{"type": "STRING", "value": "z"}, {"type": "STRING", "value": ";"}]},
    "alpha": {"type": "SEQ", "members": [{"type": "STRING", "value": "a"}, {"type": "STRING", "value": ";"}]},
    "beta": {"type": "SEQ", "members": [{"type": "STRING", "value": "b"}, {"type": "STRING", "value": ";"}]},
    "Gamma": {"type": "SEQ", "members": [{"type": "STRING", "value": "g"}, {"type": "STRING", "value": ";"}]}
