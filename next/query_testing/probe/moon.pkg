import {
  "moonbit-community/treesitter/next/api",
  "moonbit-community/treesitter/next/highlight",
  "moonbit-community/treesitter/next/language",
  "moonbit-community/treesitter/next/query_testing",
  "moonbit-community/treesitter/next/regex",
  "moonbit-community/treesitter/next/scanners",
  "moonbit-community/treesitter/next/tags",
