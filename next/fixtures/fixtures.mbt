// Test helpers shared by the native-only test packages of next/highlight,
// next/tags and next/query_testing: upstream's
// crates/cli/src/tests/helpers/fixtures.rs (`get_language`,
// `get_language_queries_path`, `get_highlight_config`, `get_tags_config`).
//
// Fixture languages are read from `_build/reflang/fixture_<name>.json`
// (generated by the pinned upstream CLI and converted with
// tools/next/language_from_c.py, see tools/next/ref_generate.sh), and their
// queries from the fixture grammars of the pinned upstream checkout
// (`.repos/ts-pinned`, found next to the repository or its worktree, or
// named by the environment variable `TS_PINNED`). When either is missing, or
// when a grammar's external scanner has not been ported to next/scanners yet,
// these helpers return `None` and print a notice, and the tests that need
// them are skipped.

///|
let language_cache : Map[String, @api.Language] = Map([])

///|
let notices : Map[String, Bool] = Map([])

///|
fn notice(key : String, message : String) -> Unit {
  if !notices.contains(key) {
    notices[key] = true
    println("note: \{message}")
  }
}

///|
/// Grammars whose external scanner has been ported to `next/scanners` (the
/// registry still contains placeholders for the others, which abort).
pub let ported_scanners : Array[String] = [
  "bash", "ruby", "python", "cpp", "jsdoc", "html", "javascript", "rust", "typescript",
  "tsx", "php", "php_only", "depends_on_column", "depends_on_column_failed_scan",
  "depends_on_column_repetition", "epsilon_external_extra_tokens", "epsilon_external_tokens",
  "external_and_internal_anonymous_tokens", "external_and_internal_tokens", "external_extra_tokens",
  "external_lookahead_eof_boundary", "external_tokens", "external_unicode_column_alignment",
  "external_word_token", "get_col_eof", "get_col_should_hang_not_crash", "inverted_external_token",
  "uses_current_column", "utf16_surrogate_oob", "wasm_realloc_clobber_region", "wasm_realloc_overflow_heap",
]

///|
async fn read_first(paths : Array[String]) -> String? {
  for path in paths {
    if @fs.exists(path) {
      return Some(@fs.read_file(path).text())
    }
  }
  None
}

///|
/// The JSON file name of a fixture language.
fn fixture_file(name : String) -> String {
  match name {
    "typescript" => "fixture_typescript_typescript"
    "tsx" => "fixture_typescript_tsx"
    "php" => "fixture_php_php"
    "php_only" => "fixture_php_php_only"
    _ => "fixture_\{name}"
  }
}

///|
/// The fixture language `name`, or `None` (with a notice) when its tables
/// are not available or when its external scanner is not ported yet.
pub async fn get_language(name : String) -> @api.Language? {
  if language_cache.get(name) is Some(language) {
    return Some(language)
  }
  let file = "\{fixture_file(name)}.json"
  let candidates = ["_build/reflang/\{file}", "../../../_build/reflang/\{file}"]
  guard read_first(candidates) is Some(text) else {
    notice(name, "skipping tests that need the `\{name}` fixture language")
    return None
  }
  let raw : @language.Language = @json.from_json(@json.parse(text))
  if raw.external_token_count > 0 && !ported_scanners.contains(name) {
    notice(
      name,
      "skipping tests that parse `\{name}` (external scanner pending)",
    )
    return None
  }
  let scanner = if raw.external_token_count > 0 {
    @scanners.scanner_for(raw.name)
  } else {
    None
  }
  let language = match scanner {
    Some(scanner) => @api.Language::new(raw, external_scanner=scanner)
    None => @api.Language::new(raw)
  }
  language_cache[name] = language
  Some(language)
}

///|
/// The `test/fixtures/grammars` directory of the pinned upstream checkout.
async fn grammars_dir() -> String? {
  let roots = match @env.get_env_var("TS_PINNED") {
    Some(root) => [root]
    None => []
  }
  roots.append([
    ".repos/ts-pinned", "../../../.repos/ts-pinned", "../../../../../.repos/ts-pinned",
    "../../../../../../.repos/ts-pinned",
  ])
  for root in roots {
    let dir = "\{root}/test/fixtures/grammars"
    if @fs.exists(dir) {
      return Some(dir)
    }
  }
  notice(
    "grammars", "skipping tests that need the fixture grammars' queries (no .repos/ts-pinned)",
  )
  None
}

///|
/// The directory holding a fixture language's queries.
pub async fn get_language_queries_path(name : String) -> String? {
  guard grammars_dir() is Some(dir) else { return None }
  Some(
    match name {
      "typescript" | "tsx" => "\{dir}/typescript/queries"
      "php" | "php_only" => "\{dir}/php/queries"
      _ => "\{dir}/\{name}/queries"
    },
  )
}

///|
/// The contents of a query file of a fixture language, if it exists.
pub async fn read_query(name : String, file : String) -> String? {
  guard get_language_queries_path(name) is Some(dir) else { return None }
  let path = "\{dir}/\{file}"
  if @fs.exists(path) {
    Some(@fs.read_file(path).text())
  } else {
    None
  }
}

///|
/// Upstream's `get_highlight_config`: the highlights, injections (when a file
/// is given) and locals (when present) queries of a fixture language,
/// configured with `highlight_names`.
pub async fn get_highlight_config(
  language_name : String,
  injection_query_filename : String?,
  highlight_names : ArrayView[String],
) -> @highlight.HighlightConfiguration? {
  guard get_language(language_name) is Some(language) else { return None }
  guard read_query(language_name, "highlights.scm") is Some(highlights_query) else {
    return None
  }
  let injections_query = match injection_query_filename {
    Some(file) => read_query(language_name, file).unwrap_or("")
    None => ""
  }
  let locals_query = read_query(language_name, "locals.scm").unwrap_or("")
  let result = @highlight.HighlightConfiguration::new(
    language, language_name, highlights_query, injections_query, locals_query,
  )
  result.configure(highlight_names)
  Some(result)
}

///|
/// Upstream's `get_tags_config`.
pub async fn get_tags_config(
  language_name : String,
) -> @tags.TagsConfiguration? {
  guard get_language(language_name) is Some(language) else { return None }
  guard read_query(language_name, "tags.scm") is Some(tags_query) else {
    return None
  }
  let locals_query = read_query(language_name, "locals.scm").unwrap_or("")
  Some(@tags.TagsConfiguration::new(language, tags_query, locals_query))
}
