///|
pub let tree_sitter_json_schema : String = "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json"

///|
pub(all) struct JsonConfigOpts {
  mut name : String
  mut camelcase : String
  mut title : String
  mut description : String
  mut repository : String?
  mut funding : String?
  mut scope : String
  mut file_types : Array[String]
  mut version : @loader.SemverVersion
  mut license : String
  mut author : String
  mut email : String?
  mut url : String?
  mut namespace : String?
  mut bindings : @loader.Bindings
} derive(Debug)

///|
/// `Serialize for JsonConfigOpts` (field order and `skip_serializing_if`
/// as derived).
pub fn JsonConfigOpts::to_json(self : JsonConfigOpts) -> Json {
  let obj : Map[String, Json] = Map([])
  obj["name"] = Json::string(self.name)
  obj["camelcase"] = Json::string(self.camelcase)
  obj["title"] = Json::string(self.title)
  obj["description"] = Json::string(self.description)
  if self.repository is Some(v) {
    obj["repository"] = Json::string(v)
  }
  if self.funding is Some(v) {
    obj["funding"] = Json::string(v)
  }
  obj["scope"] = Json::string(self.scope)
  obj["file_types"] = Json::array(self.file_types.map(Json::string))
  obj["version"] = Json::string(self.version.to_string())
  obj["license"] = Json::string(self.license)
  obj["author"] = Json::string(self.author)
  if self.email is Some(v) {
    obj["email"] = Json::string(v)
  }
  if self.url is Some(v) {
    obj["url"] = Json::string(v)
  }
  obj["namespace"] = match self.namespace {
    Some(v) => Json::string(v)
    None => Json::null()
  }
  obj["bindings"] = self.bindings.to_json()
  Json::object(obj)
}

///|
pub fn JsonConfigOpts::to_tree_sitter_json(
  self : JsonConfigOpts,
) -> @loader.TreeSitterJSON {
  let injection_regex = "^\{self.name}$"
  let class_name = "TreeSitter\{to_upper_camel_case(self.name)}"
  let repository = match self.repository {
    Some(r) => r
    None => "https://github.com/tree-sitter/tree-sitter-\{self.name}"
  }
  {
    schema: Some(tree_sitter_json_schema),
    grammars: [
      {
        name: self.name,
        camelcase: Some(self.camelcase),
        title: Some(self.title),
        scope: self.scope,
        path: None,
        external_files: Empty,
        file_types: Some(self.file_types.copy()),
        highlights: Empty,
        injections: Empty,
        locals: Empty,
        tags: Empty,
        injection_regex: Some(injection_regex),
        first_line_regex: None,
        content_regex: None,
        class_name: Some(class_name),
      },
    ],
    metadata: {
      version: self.version,
      license: Some(self.license),
      description: Some(self.description),
      authors: Some([{ name: self.author, email: self.email, url: self.url, }]),
      links: Some({ repository, funding: self.funding, }),
      namespace: self.namespace,
    },
    bindings: self.bindings,
  }
}

///|
pub fn JsonConfigOpts::default() -> JsonConfigOpts {
  {
    name: "",
    camelcase: "",
    title: "",
    description: "",
    repository: None,
    funding: None,
    scope: "",
    file_types: [],
    version: @loader.SemverVersion::new(0, 1, 0),
    license: "",
    author: "",
    email: None,
    url: None,
    namespace: None,
    bindings: @loader.Bindings::default(),
  }
}

///|
priv struct GenerateOpts {
  author_name : String?
  author_email : String?
  author_url : String?
  license : String?
  description : String?
  repository : String?
  funding : String?
  version : @loader.SemverVersion
  camel_parser_name : String
  title_parser_name : String
  class_name : String
  highlights_query_path : String
  injections_query_path : String
  locals_query_path : String
  tags_query_path : String
  namespace : String?
}

///|
priv struct InitContext {
  repo_path : String
  language_name : String
  dashed_language_name : String
  allow_update : Bool
  has_multiple_language_configs : Bool
}

///|
fn join(base : String, rel : String) -> String {
  @support.path_join(base, rel)
}

///|
/// `fs::read_to_string(path)?` inside an `anyhow::Result` function.
async fn read_file(path : String) -> String raise InitError {
  read_to_string(path) catch {
    IoError(e) => raise anyhow(e)
  }
}

///|
/// `tree_sitter_generate::write_file`: a `GenerateError::IO` naming the path.
async fn write_file(path : String, body : String) -> Unit raise InitError {
  fs_write(path, body) catch {
    IoError(e) => raise anyhow("\{e} (\{path})")
  }
}

///|
/// `serde_json::from_str::<TreeSitterJSON>(..)?`.
fn parse_tree_sitter_json(
  text : String,
) -> @loader.TreeSitterJSON raise InitError {
  @loader.TreeSitterJSON::parse(text) catch {
    @loader.JsonError(e) => raise anyhow(e)
  }
}

///|
pub async fn generate_grammar_files(
  repo_path : String,
  language_name : String,
  allow_update : Bool,
  opts : JsonConfigOpts?,
) -> Unit {
  let dashed_language_name = to_kebab_case(language_name)
  let tree_sitter_config = missing_path_else(
    join(repo_path, "tree-sitter.json"),
    true,
    path => {
      // invariant: opts is always Some when `tree-sitter.json` doesn't exist
      guard opts is Some(opts) else {
        abort("internal error: entered unreachable code")
      }
      let tree_sitter_json = opts.to_tree_sitter_json()
      write_file(path, @support.to_string_pretty(tree_sitter_json.to_json()))
    },
    path => {
      // updating the config, if needed
      if opts is Some(opts) {
        let tree_sitter_json = opts.to_tree_sitter_json()
        write_file(path, @support.to_string_pretty(tree_sitter_json.to_json()))
      }
    },
  )
  let tree_sitter_config = parse_tree_sitter_json(
    read_to_string(tree_sitter_config.as_path()) catch {
      IoError(e) => raise with_context(e, "Failed to read tree-sitter.json")
    },
  )
  let grammar = tree_sitter_config.grammars[0]
  let camel_name = grammar.camelcase.unwrap_or_else(() => {
    to_upper_camel_case(language_name)
  })
  let title_name = grammar.title.unwrap_or_else(() => {
    to_upper_camel_case(language_name)
  })
  let class_name = grammar.class_name.unwrap_or_else(() => {
    "TreeSitter\{to_upper_camel_case(language_name)}"
  })
  let authors = tree_sitter_config.metadata.authors
  let default_highlights_path = join("queries", "highlights.scm")
  let default_injections_path = join("queries", "injections.scm")
  let default_locals_path = join("queries", "locals.scm")
  let default_tags_path = join("queries", "tags.scm")
  let first_author = match authors {
    Some(a) => a.get(0)
    None => None
  }
  let generate_opts : GenerateOpts = {
    author_name: first_author.map(a => a.name),
    author_email: first_author.bind(a => a.email),
    author_url: first_author.bind(a => a.url),
    license: tree_sitter_config.metadata.license,
    description: tree_sitter_config.metadata.description,
    repository: tree_sitter_config.metadata.links.map(l => l.repository),
    funding: tree_sitter_config.metadata.links.bind(l => l.funding),
    version: tree_sitter_config.metadata.version,
    camel_parser_name: camel_name,
    title_parser_name: title_name,
    class_name,
    highlights_query_path: grammar.highlights.to_variable_value(
      default_highlights_path,
    ),
    injections_query_path: grammar.injections.to_variable_value(
      default_injections_path,
    ),
    locals_query_path: grammar.locals.to_variable_value(default_locals_path),
    tags_query_path: grammar.tags.to_variable_value(default_tags_path),
    namespace: tree_sitter_config.metadata.namespace,
  }
  let ctx : InitContext = {
    repo_path,
    language_name,
    dashed_language_name,
    allow_update,
    has_multiple_language_configs: tree_sitter_config.has_multiple_language_configs(),
  }
  let bindings_dir = join(repo_path, "bindings")
  generate_common_files(ctx, generate_opts)
  if tree_sitter_config.bindings.rust {
    generate_rust_bindings(ctx, generate_opts, bindings_dir)
  }
  if tree_sitter_config.bindings.node {
    generate_node_bindings(ctx, generate_opts, bindings_dir)
  }
  if tree_sitter_config.bindings.c {
    generate_c_bindings(ctx, generate_opts, bindings_dir)
  }
  if tree_sitter_config.bindings.go {
    generate_go_bindings(ctx, generate_opts, bindings_dir)
  }
  if tree_sitter_config.bindings.python {
    generate_python_bindings(ctx, generate_opts, bindings_dir)
  }
  if tree_sitter_config.bindings.swift {
    generate_swift_bindings(ctx, generate_opts, bindings_dir)
  }
  if tree_sitter_config.bindings.zig {
    generate_zig_bindings(ctx, generate_opts, bindings_dir)
  }
  if tree_sitter_config.bindings.java {
    generate_java_bindings(ctx, generate_opts, bindings_dir)
  }
}

///|
async fn generate_common_files(ctx : InitContext, opts : GenerateOpts) -> Unit {
  // Create package.json
  ignore(
    missing_path_else(
      join(ctx.repo_path, "package.json"),
      ctx.allow_update,
      path => {
        generate_file(
          path,
          package_json_template,
          ctx.dashed_language_name,
          opts,
        )
      },
      update_package_json,
    ),
  )

  // Do not create a grammar.js file in a repo with multiple language configs
  if !ctx.has_multiple_language_configs {
    ignore(
      missing_path_else(
        join(ctx.repo_path, "grammar.js"),
        ctx.allow_update,
        path => {
          generate_file(path, grammar_js_template, ctx.language_name, opts)
        },
        update_grammar_js,
      ),
    )
  }

  // Write .gitignore file
  ignore(
    missing_path_else(
      join(ctx.repo_path, ".gitignore"),
      ctx.allow_update,
      path => generate_file(path, gitignore_template, ctx.language_name, opts),
      update_gitignore,
    ),
  )

  // Write .gitattributes file
  ignore(
    missing_path_else(
      join(ctx.repo_path, ".gitattributes"),
      ctx.allow_update,
      path => {
        generate_file(path, gitattributes_template, ctx.language_name, opts)
      },
      update_gitattributes,
    ),
  )

  // Write .editorconfig file
  ignore(
    missing_path(join(ctx.repo_path, ".editorconfig"), path => {
      generate_file(path, editorconfig_template, ctx.language_name, opts)
    }),
  )
}

///|
async fn generate_rust_bindings(
  ctx : InitContext,
  opts : GenerateOpts,
  bindings_dir : String,
) -> Unit {
  ignore(
    missing_path(join(bindings_dir, "rust"), create_dir).apply(path => {
      ignore(
        missing_path_else(
          join(path, "lib.rs"),
          ctx.allow_update,
          path => generate_file(path, lib_rs_template, ctx.language_name, opts),
          path => update_rust_lib_rs(path, opts),
        ),
      )
      ignore(
        missing_path_else(
          join(path, "build.rs"),
          ctx.allow_update,
          path => {
            generate_file(path, build_rs_template, ctx.language_name, opts)
          },
          path => update_rust_build_rs(path, ctx.language_name, opts),
        ),
      )
      ignore(
        missing_path_else(
          join(ctx.repo_path, "Cargo.toml"),
          ctx.allow_update,
          path => {
            generate_file(
              path,
              cargo_toml_template,
              ctx.dashed_language_name,
              opts,
            )
          },
          path => {
            let contents = read_file(path)
            if contents.contains("\"LICENSE\"") {
              @support.log_info(
                "Adding LICENSE entry to bindings/rust/Cargo.toml",
              )
              write_file(
                path,
                contents.replace_all(old="\"LICENSE\"", new="\"/LICENSE\""),
              )
            }
          },
        ),
      )
    }),
  )
}

///|
async fn generate_node_bindings(
  ctx : InitContext,
  opts : GenerateOpts,
  bindings_dir : String,
) -> Unit {
  ignore(
    missing_path(join(bindings_dir, "node"), create_dir).apply(path => {
      ignore(
        missing_path_else(
          join(path, "index.js"),
          ctx.allow_update,
          path => {
            generate_file(path, index_js_template, ctx.language_name, opts)
          },
          path => {
            regenerate_if_missing(
              path,
              "type: \"text\"",
              index_js_template,
              ctx.language_name,
              opts,
            )
          },
        ),
      )
      ignore(
        missing_path_else(
          join(path, "index.d.ts"),
          ctx.allow_update,
          path => {
            generate_file(path, index_d_ts_template, ctx.language_name, opts)
          },
          path => {
            regenerate_if_missing(
              path,
              "export default binding",
              index_d_ts_template,
              ctx.language_name,
              opts,
            )
          },
        ),
      )
      ignore(
        missing_path_else(
          join(path, "binding_test.js"),
          ctx.allow_update,
          path => {
            generate_file(
              path,
              binding_test_js_template,
              ctx.language_name,
              opts,
            )
          },
          path => {
            regenerate_if_missing(
              path,
              "await assert.doesNotReject",
              binding_test_js_template,
              ctx.language_name,
              opts,
            )
          },
        ),
      )
      ignore(
        missing_path(join(path, "binding.cc"), path => {
          generate_file(path, js_binding_cc_template, ctx.language_name, opts)
        }),
      )
      ignore(
        missing_path_else(
          join(ctx.repo_path, "binding.gyp"),
          ctx.allow_update,
          path => {
            generate_file(path, binding_gyp_template, ctx.language_name, opts)
          },
          path => {
            let contents = read_file(path)
            if contents.contains("fs.exists(") {
              @support.log_info("Replacing `fs.exists` calls in binding.gyp")
              write_file(
                path,
                contents.replace_all(old="fs.exists(", new="fs.existsSync("),
              )
            }
          },
        ),
      )
    }),
  )
}

///|
async fn generate_c_bindings(
  ctx : InitContext,
  opts : GenerateOpts,
  bindings_dir : String,
) -> Unit {
  let kebab_case_name = to_kebab_case(ctx.language_name)
  ignore(
    missing_path(join(bindings_dir, "c"), create_dir).apply(path => {
      let header_name = "tree-sitter-\{kebab_case_name}.h"
      let old_file = join(path, header_name)
      if ctx.allow_update && path_exists(old_file) {
        @support.log_info("Removing bindings/c/\{header_name}")
        remove_file(old_file) catch {
          IoError(e) => raise anyhow(e)
        }
      }
      ignore(
        missing_path(join(path, "tree_sitter"), create_dir).apply(include_path => {
          ignore(
            missing_path(join(include_path, header_name), path => {
              generate_file(
                path,
                parser_name_h_template,
                ctx.language_name,
                opts,
              )
            }),
          )
        }),
      )
      ignore(
        missing_path(join(path, "tree-sitter-\{kebab_case_name}.pc.in"), path => {
          generate_file(
            path,
            parser_name_pc_in_template,
            ctx.language_name,
            opts,
          )
        }),
      )
      ignore(
        missing_path_else(
          join(ctx.repo_path, "Makefile"),
          ctx.allow_update,
          path => {
            generate_file(path, makefile_template, ctx.language_name, opts)
          },
          path => update_c_makefile(path, ctx.language_name, opts),
        ),
      )
      ignore(
        missing_path_else(
          join(ctx.repo_path, "CMakeLists.txt"),
          ctx.allow_update,
          path => {
            generate_file(
              path,
              cmakelists_txt_template,
              ctx.language_name,
              opts,
            )
          },
          path => update_c_cmakelists(path, ctx.language_name),
        ),
      )
    }),
  )
}

///|
async fn generate_go_bindings(
  ctx : InitContext,
  opts : GenerateOpts,
  bindings_dir : String,
) -> Unit {
  ignore(
    missing_path(join(bindings_dir, "go"), create_dir).apply(path => {
      ignore(
        missing_path(join(path, "binding.go"), path => {
          generate_file(path, binding_go_template, ctx.language_name, opts)
        }),
      )
      ignore(
        missing_path(join(path, "binding_test.go"), path => {
          generate_file(path, binding_test_go_template, ctx.language_name, opts)
        }),
      )
      ignore(
        missing_path(join(ctx.repo_path, "go.mod"), path => {
          generate_file(path, go_mod_template, ctx.language_name, opts)
        }),
      )
    }),
  )
}

///|
async fn generate_python_bindings(
  ctx : InitContext,
  opts : GenerateOpts,
  bindings_dir : String,
) -> Unit {
  ignore(
    missing_path(join(bindings_dir, "python"), create_dir).apply(path => {
      let snake_case_grammar_name = "tree_sitter_\{to_snake_case(ctx.language_name)}"
      let lang_path = join(path, snake_case_grammar_name)
      ignore(missing_path(lang_path, create_dir))
      ignore(
        missing_path_else(
          join(lang_path, "binding.c"),
          ctx.allow_update,
          path => {
            generate_file(path, py_binding_c_template, ctx.language_name, opts)
          },
          path => update_python_binding_c(path, snake_case_grammar_name),
        ),
      )
      ignore(
        missing_path_else(
          join(lang_path, "__init__.py"),
          ctx.allow_update,
          path => generate_file(path, init_py_template, ctx.language_name, opts),
          path => {
            let contents = read_file(path)
            if contents.contains("uncomment these to include any queries") {
              @support.log_info("Replacing __init__.py")
              generate_file(path, init_py_template, ctx.language_name, opts)
            }
          },
        ),
      )
      ignore(
        missing_path_else(
          join(lang_path, "__init__.pyi"),
          ctx.allow_update,
          path => {
            generate_file(path, init_pyi_template, ctx.language_name, opts)
          },
          path => update_python_init_pyi(path, ctx.language_name, opts),
        ),
      )
      ignore(
        missing_path(join(lang_path, "py.typed"), path => {
          generate_file(path, "", ctx.language_name, opts)
        }), // py.typed is empty
      )
      ignore(
        missing_path(join(path, "tests"), create_dir).apply(path => {
          ignore(
            missing_path_else(
              join(path, "test_binding.py"),
              ctx.allow_update,
              path => {
                generate_file(
                  path,
                  test_binding_py_template,
                  ctx.language_name,
                  opts,
                )
              },
              update_python_test_binding,
            ),
          )
        }),
      )
      ignore(
        missing_path_else(
          join(ctx.repo_path, "setup.py"),
          ctx.allow_update,
          path => {
            generate_file(path, setup_py_template, ctx.language_name, opts)
          },
          path => update_python_setup_py(path, ctx.language_name, opts),
        ),
      )
      ignore(
        missing_path_else(
          join(ctx.repo_path, "pyproject.toml"),
          ctx.allow_update,
          path => {
            generate_file(
              path,
              pyproject_toml_template,
              ctx.dashed_language_name,
              opts,
            )
          },
          path => {
            let mut contents = read_file(path)
            if !contents.contains("cp310-*") {
              @support.log_info("Updating dependencies in pyproject.toml")
              contents = contents
                .replace_all(
                  old="build = \"cp39-*\"",
                  new="build = \"cp310-*\"",
                )
                .replace_all(
                  old="python = \">=3.9\"",
                  new="python = \">=3.10\"",
                )
                .replace_all(old="tree-sitter~=0.22", new="tree-sitter~=0.24")
              write_file(path, contents)
            }
          },
        ),
      )
    }),
  )
}

///|
async fn generate_swift_bindings(
  ctx : InitContext,
  opts : GenerateOpts,
  bindings_dir : String,
) -> Unit {
  ignore(
    missing_path(join(bindings_dir, "swift"), create_dir).apply(path => {
      let lang_path = join(path, opts.class_name)
      ignore(missing_path(lang_path, create_dir))
      ignore(
        missing_path(join(lang_path, "\{ctx.language_name}.h"), path => {
          generate_file(path, parser_name_h_template, ctx.language_name, opts)
        }),
      )
      ignore(
        missing_path(join(path, "\{opts.class_name}Tests"), create_dir).apply(path => {
          ignore(
            missing_path(join(path, "\{opts.class_name}Tests.swift"), path => {
              generate_file(path, tests_swift_template, ctx.language_name, opts)
            }),
          )
        }),
      )
      ignore(
        missing_path_else(
          join(ctx.repo_path, "Package.swift"),
          ctx.allow_update,
          path => {
            generate_file(path, package_swift_template, ctx.language_name, opts)
          },
          update_swift_package,
        ),
      )
    }),
  )
}

///|
async fn generate_zig_bindings(
  ctx : InitContext,
  opts : GenerateOpts,
  bindings_dir : String,
) -> Unit {
  ignore(
    missing_path_else(
      join(ctx.repo_path, "build.zig"),
      ctx.allow_update,
      path => generate_file(path, build_zig_template, ctx.language_name, opts),
      path => {
        regenerate_if_missing(
          path,
          "b.pkg_hash.len",
          build_zig_template,
          ctx.language_name,
          opts,
        )
      },
    ),
  )
  ignore(
    missing_path_else(
      join(ctx.repo_path, "build.zig.zon"),
      ctx.allow_update,
      path => {
        generate_file(path, build_zig_zon_template, ctx.language_name, opts)
      },
      path => {
        regenerate_if_missing(
          path,
          ".name = .tree_sitter_",
          build_zig_zon_template,
          ctx.language_name,
          opts,
        )
      },
    ),
  )
  ignore(
    missing_path(join(bindings_dir, "zig"), create_dir).apply(path => {
      ignore(
        missing_path_else(
          join(path, "root.zig"),
          ctx.allow_update,
          path => {
            generate_file(path, root_zig_template, ctx.language_name, opts)
          },
          path => {
            let contents = read_file(path)
            if contents.contains("ts.Language") {
              @support.log_info("Replacing root.zig")
              generate_file(path, root_zig_template, ctx.language_name, opts)
            }
          },
        ),
      )
      ignore(
        missing_path(join(path, "test.zig"), path => {
          generate_file(path, test_zig_template, ctx.language_name, opts)
        }),
      )
    }),
  )
}

///|
async fn generate_java_bindings(
  ctx : InitContext,
  opts : GenerateOpts,
  bindings_dir : String,
) -> Unit {
  ignore(
    missing_path(join(ctx.repo_path, "pom.xml"), path => {
      generate_file(path, pom_xml_template, ctx.language_name, opts)
    }),
  )
  ignore(
    missing_path(join(bindings_dir, "java"), create_dir).apply(path => {
      ignore(
        missing_path(join(path, "main"), create_dir).apply(path => {
          let mut package_path = path
          for
            dir in opts.namespace
            .unwrap_or("io.github.treesitter")
            .replace_all(old="-", new="")
            .replace_all(old="_", new="")
            .split(".") {
            package_path = path_push(package_path, dir.to_owned())
          }
          package_path = join(
            join(package_path, "jtreesitter"),
            rust_to_lowercase(ctx.language_name).replace_all(old="_", new=""),
          )
          ignore(
            missing_path(package_path, create_dir).apply(path => {
              ignore(
                missing_path(join(path, "\{opts.class_name}.java"), path => {
                  generate_file(
                    path,
                    binding_java_template,
                    ctx.language_name,
                    opts,
                  )
                }),
              )
            }),
          )
        }),
      )
      ignore(
        missing_path(join(path, "test"), create_dir).apply(path => {
          ignore(
            missing_path(join(path, "\{opts.class_name}Test.java"), path => {
              generate_file(path, test_java_template, ctx.language_name, opts)
            }),
          )
        }),
      )
    }),
  )
}

///|
/// `PathBuf::join` with Rust's handling of an empty component (a trailing
/// separator is added).
fn path_push(base : String, rel : String) -> String {
  if rel.is_empty() {
    if base.has_suffix("/") {
      base
    } else {
      base + "/"
    }
  } else {
    join(base, rel)
  }
}

///|
/// `str::to_lowercase` (ASCII; see heck.mbt).
fn rust_to_lowercase(s : String) -> String {
  let sb = StringBuilder()
  for c in s {
    sb.write_char(c.to_ascii_lowercase())
  }
  sb.to_string()
}

// TODO: remove old migrations

///|
async fn update_package_json(path : String) -> Unit {
  let mut contents = read_file(path)
    .replace_all(
      old="\"node-addon-api\": \"^8.3.1\"",
      new="\"node-addon-api\": \"^8.5.0\"",
    )
    .replace_all(
      old=indoc(
        (
          #|
          #|            "prebuildify": "^6.0.1",
          #|            "tree-sitter-cli":
        ),
      ),
      new=indoc(
        (
          #|
          #|            "prebuildify": "^6.0.1",
          #|            "tree-sitter": "^0.25.0",
          #|            "tree-sitter-cli":
        ),
      ),
    )
  if !contents.contains("module") {
    @support.log_info("Migrating package.json to ESM")
    contents = contents.replace_all(
      old="\"repository\":",
      new=indoc(
        (
          #|
          #|            "type": "module",
          #|              "repository":
        ),
      ),
    )
  }
  write_file(path, contents)
}

///|
async fn update_grammar_js(path : String) -> Unit {
  let mut contents = read_file(path)
  if contents.contains("module.exports") {
    @support.log_info("Migrating grammar.js to ESM")
    contents = contents.replace_all(
      old="module.exports =",
      new="export default",
    )
    write_file(path, contents)
  }
}

///|
async fn update_gitignore(path : String) -> Unit {
  // NOTE: this modifies `contents` but never calls `write_file` (pre-existing bug)
  let contents = read_file(path)
  if !contents.contains("Zig artifacts") {
    @support.log_info("Adding zig entries to .gitignore")
  }
}

///|
async fn update_gitattributes(path : String) -> Unit {
  let mut contents = read_file(path)
  let c_bindings_entry = "bindings/c/* "
  if contents.contains(c_bindings_entry) {
    @support.log_info("Updating c bindings entry in .gitattributes")
    contents = contents.replace_all(old=c_bindings_entry, new="bindings/c/** ")
  }
  if !contents.contains("Zig bindings") {
    @support.log_info("Adding zig entries to .gitattributes")
    contents = contents +
      "\n" +
      indoc(
        (
          #|
          #|        # Zig bindings
          #|        build.zig linguist-generated
          #|        build.zig.zon linguist-generated
          #|
        ),
      )
  }
  write_file(path, contents)
}

///|
fn replace_query_paths(s : String, opts : GenerateOpts) -> String {
  s
  .replace_all(
    old=HIGHLIGHTS_QUERY_PATH_PLACEHOLDER,
    new=opts.highlights_query_path.replace_all(old="\\", new="/"),
  )
  .replace_all(
    old=INJECTIONS_QUERY_PATH_PLACEHOLDER,
    new=opts.injections_query_path.replace_all(old="\\", new="/"),
  )
  .replace_all(
    old=LOCALS_QUERY_PATH_PLACEHOLDER,
    new=opts.locals_query_path.replace_all(old="\\", new="/"),
  )
  .replace_all(
    old=TAGS_QUERY_PATH_PLACEHOLDER,
    new=opts.tags_query_path.replace_all(old="\\", new="/"),
  )
}

///|
async fn update_rust_lib_rs(path : String, opts : GenerateOpts) -> Unit {
  let mut contents = read_file(path)
  if !contents.contains("#[cfg(with_highlights_query)]") {
    @support.log_info("Updating query constants in bindings/rust/lib.rs")
    let replacement = replace_query_paths(
      indoc(
        (
          #|
          #|            #[cfg(with_highlights_query)]
          #|            /// The syntax highlighting query for this grammar.
          #|            pub const HIGHLIGHTS_QUERY: &str = include_str!("../../HIGHLIGHTS_QUERY_PATH");
          #|
          #|            #[cfg(with_injections_query)]
          #|            /// The language injection query for this grammar.
          #|            pub const INJECTIONS_QUERY: &str = include_str!("../../INJECTIONS_QUERY_PATH");
          #|
          #|            #[cfg(with_locals_query)]
          #|            /// The local variable query for this grammar.
          #|            pub const LOCALS_QUERY: &str = include_str!("../../LOCALS_QUERY_PATH");
          #|
          #|            #[cfg(with_tags_query)]
          #|            /// The symbol tagging query for this grammar.
          #|            pub const TAGS_QUERY: &str = include_str!("../../TAGS_QUERY_PATH");
          #|
        ),
      ),
      opts,
    )
    contents = contents.replace_all(
      old=indoc(
        (
          #|
          #|                // NOTE: uncomment these to include any queries that this grammar contains:
          #|
          #|                // pub const HIGHLIGHTS_QUERY: &str = include_str!("../../queries/highlights.scm");
          #|                // pub const INJECTIONS_QUERY: &str = include_str!("../../queries/injections.scm");
          #|                // pub const LOCALS_QUERY: &str = include_str!("../../queries/locals.scm");
          #|                // pub const TAGS_QUERY: &str = include_str!("../../queries/tags.scm");
          #|
        ),
      ),
      new=replacement,
    )
  }
  write_file(path, contents)
}

///|
async fn update_rust_build_rs(
  path : String,
  language_name : String,
  opts : GenerateOpts,
) -> Unit {
  let mut contents = read_file(path)
  if !contents.contains("wasm32-unknown-unknown") {
    @support.log_info(
      "Adding wasm32-unknown-unknown target to bindings/rust/build.rs",
    )
    let replacement = rust_lines(
        indoc(
          (
            #|
            #|            c_config.flag("-utf-8");
            #|
            #|            if std::env::var("TARGET").unwrap() == "wasm32-unknown-unknown" {
            #|                let Ok(wasm_headers) = std::env::var("DEP_TREE_SITTER_LANGUAGE_WASM_HEADERS") else {
            #|                    panic!("Environment variable DEP_TREE_SITTER_LANGUAGE_WASM_HEADERS must be set by the language crate");
            #|                };
            #|
            #|                c_config.include(&wasm_headers);
            #|            }
            #|
          ),
        ),
      )
      .map(line => if line.is_empty() { line } else { "    \{line}" })
      .join("\n")
    contents = contents.replace_all(
      old="    c_config.flag(\"-utf-8\");",
      new=replacement,
    )
  }

  // Introduce configuration variables for dynamic query inclusion
  if !contents.contains("with_highlights_query") {
    @support.log_info(
      "Adding support for dynamic query inclusion to bindings/rust/build.rs",
    )
    let replaced = indoc(
      (
        #|
        #|                c_config.compile("tree-sitter-KEBAB_PARSER_NAME");
        #|            }
      ),
    ).replace_all(old="KEBAB_PARSER_NAME", new=to_kebab_case(language_name))
    let replacement = replace_query_paths(
      indoc(
        (
          #|
          #|                c_config.compile("tree-sitter-KEBAB_PARSER_NAME");
          #|
          #|                println!("cargo:rustc-check-cfg=cfg(with_highlights_query)");
          #|                if !"HIGHLIGHTS_QUERY_PATH".is_empty() && std::path::Path::new("HIGHLIGHTS_QUERY_PATH").exists() {
          #|                    println!("cargo:rustc-cfg=with_highlights_query");
          #|                }
          #|                println!("cargo:rustc-check-cfg=cfg(with_injections_query)");
          #|                if !"INJECTIONS_QUERY_PATH".is_empty() && std::path::Path::new("INJECTIONS_QUERY_PATH").exists() {
          #|                    println!("cargo:rustc-cfg=with_injections_query");
          #|                }
          #|                println!("cargo:rustc-check-cfg=cfg(with_locals_query)");
          #|                if !"LOCALS_QUERY_PATH".is_empty() && std::path::Path::new("LOCALS_QUERY_PATH").exists() {
          #|                    println!("cargo:rustc-cfg=with_locals_query");
          #|                }
          #|                println!("cargo:rustc-check-cfg=cfg(with_tags_query)");
          #|                if !"TAGS_QUERY_PATH".is_empty() && std::path::Path::new("TAGS_QUERY_PATH").exists() {
          #|                    println!("cargo:rustc-cfg=with_tags_query");
          #|                }
          #|            }
        ),
      ).replace_all(old="KEBAB_PARSER_NAME", new=to_kebab_case(language_name)),
      opts,
    )
    contents = contents.replace_all(old=replaced, new=replacement)
  }
  write_file(path, contents)
}

///|
async fn update_c_makefile(
  path : String,
  language_name : String,
  opts : GenerateOpts,
) -> Unit {
  let mut contents = read_file(path)
  if !contents.contains("cd '$(DESTDIR)$(LIBDIR)' && ln -sf") {
    @support.log_info("Replacing Makefile")
    generate_file(path, makefile_template, language_name, opts)
  } else {
    let replaced = indoc(
      (
        #|
        #|            $(PARSER): $(SRC_DIR)/grammar.json
        #|                    $(TS) generate $^
        #|
      ),
    )
    if contents.contains(replaced) {
      @support.log_info("Adding --no-parser target to Makefile")
      contents = contents.replace_all(
        old=replaced,
        new=indoc(
          (
            #|
            #|                    $(SRC_DIR)/grammar.json: grammar.js
            #|                            $(TS) generate --no-parser $^
            #|
            #|                    $(PARSER): $(SRC_DIR)/grammar.json
            #|                            $(TS) generate $^
            #|
          ),
        ),
      )
    }
    if !contents.contains("\nDESCRIPTION :=") {
      let mut version_line = None
      for l in rust_lines(contents) {
        if l.has_prefix("VERSION := ") {
          version_line = Some(l)
          break
        }
      }
      if version_line is Some(version_line) {
        @support.log_info("Adding DESCRIPTION to Makefile")
        let description = match opts.description {
          Some(d) => d
          None => "\{opts.camel_parser_name} grammar for tree-sitter"
        }
        contents = contents.replace_all(
          old=version_line,
          new="\{version_line}\nDESCRIPTION := \{description}",
        )
      }
    }
    write_file(path, contents)
  }
}

