          #|                                       PRIVATE src
          #|                                       INTERFACE $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/bindings/c>
          #|                                                 $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>)
          #|
        ),
      ).replace_all(old="{language_name}", new=language_name),
    )
    .replace_all(
      old=indoc(
        (
          #|
          #|            add_custom_command(OUTPUT "${CMAKE_CURRENT_SOURCE_DIR}/src/parser.c"
          #|                               DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/src/grammar.json"
          #|                               COMMAND "${TREE_SITTER_CLI}" generate src/grammar.json
          #|                                        --abi=${TREE_SITTER_ABI_VERSION}
          #|                               WORKING_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}"
          #|                               COMMENT "Generating parser.c")
          #|
        ),
      ),
      new=indoc(
        (
          #|
          #|            add_custom_command(OUTPUT "${CMAKE_CURRENT_SOURCE_DIR}/src/grammar.json"
          #|                                      "${CMAKE_CURRENT_SOURCE_DIR}/src/node-types.json"
          #|                               DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/grammar.js"
          #|                               COMMAND "${TREE_SITTER_CLI}" generate grammar.js --no-parser
          #|                               WORKING_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}"
          #|                               COMMENT "Generating grammar.json")
          #|
          #|            add_custom_command(OUTPUT "${CMAKE_CURRENT_SOURCE_DIR}/src/parser.c"
          #|                               BYPRODUCTS "${CMAKE_CURRENT_SOURCE_DIR}/src/tree_sitter/parser.h"
          #|                                          "${CMAKE_CURRENT_SOURCE_DIR}/src/tree_sitter/alloc.h"
          #|                                          "${CMAKE_CURRENT_SOURCE_DIR}/src/tree_sitter/array.h"
          #|                               DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/src/grammar.json"
          #|                               COMMAND "${TREE_SITTER_CLI}" generate src/grammar.json
          #|                                        --abi=${TREE_SITTER_ABI_VERSION}
          #|                               WORKING_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}"
          #|                               COMMENT "Generating parser.c")
          #|
        ),
      ),
    )
  if replaced_contents != contents {
    @support.log_info("Updating CMakeLists.txt")
    write_file(path, replaced_contents)
  }
}

///|
async fn update_python_binding_c(
  path : String,
  snake_case_grammar_name : String,
) -> Unit {
  let mut contents = read_file(path)
  if !contents.contains("PyModuleDef_Init") {
    @support.log_info(
      "Updating bindings/python/\{snake_case_grammar_name}/binding.c",
    )
    contents = contents
      .replace_all(old="PyModule_Create", new="PyModuleDef_Init")
      .replace_all(
        old="static PyMethodDef methods[] = {\n",
        new=indoc(
          (
            #|
            #|                static struct PyModuleDef_Slot slots[] = {
            #|                #ifdef Py_GIL_DISABLED
            #|                    {Py_mod_gil, Py_MOD_GIL_NOT_USED},
            #|                #endif
            #|                    {0, NULL}
            #|                };
            #|
            #|                static PyMethodDef methods[] = {
            #|
          ),
        ),
      )
      .replace_all(
        old=indoc(
          (
            #|
            #|                .m_size = -1,
            #|                    .m_methods = methods
            #|
          ),
        ),
        new=indoc(
          (
            #|
            #|                .m_size = 0,
            #|                    .m_methods = methods,
            #|                    .m_slots = slots,
            #|
          ),
        ),
      )
    write_file(path, contents)
  }
}

///|
async fn update_python_init_pyi(
  path : String,
  language_name : String,
  opts : GenerateOpts,
) -> Unit {
  let mut contents = read_file(path)
  if contents.contains("uncomment these to include any queries") {
    @support.log_info("Replacing __init__.pyi")
    generate_file(path, init_pyi_template, language_name, opts)
  } else if !contents.contains("CapsuleType") {
    @support.log_info("Updating __init__.pyi")
    contents = contents
      .replace_all(
        old="from typing import Final",
        new="from typing import Final\nfrom typing_extensions import CapsuleType",
      )
      .replace_all(old="-> object:", new="-> CapsuleType:")
    write_file(path, contents)
  }
}

///|
async fn update_python_test_binding(path : String) -> Unit {
  let mut contents = read_file(path)
  if !contents.contains("Parser(Language(") {
    @support.log_info(
      "Updating Language function in bindings/python/tests/test_binding.py",
    )
    contents = contents
      .replace_all(old="tree_sitter.Language(", new="Parser(Language(")
      .replace_all(old=".language())\n", new=".language()))\n")
      .replace_all(
        old="import tree_sitter\n",
        new="from tree_sitter import Language, Parser\n",
      )
    write_file(path, contents)
  }
}

///|
async fn update_python_setup_py(
  path : String,
  language_name : String,
  opts : GenerateOpts,
) -> Unit {
  let mut contents = read_file(path)
  if !contents.contains("build_ext") {
    @support.log_info("Replacing setup.py")
    generate_file(path, setup_py_template, language_name, opts)
  } else {
    if !contents.contains(" and not get_config_var") {
      @support.log_info("Updating Python free-threading support in setup.py")
      contents = contents.replace_all(
        old="startswith(\"cp\"):",
        new="startswith(\"cp\") and not get_config_var(\"Py_GIL_DISABLED\"):",
      )
      write_file(path, contents)
    }
    if !contents.contains("include(\"src/*.c\")") {
      @support.log_info("Updating sdist file list in setup.py")
      let contents = contents.replace_all(
        old="include(\"src/tree_sitter/*.h\")",
        new="include(\"src/tree_sitter/*.h\")\n        self.filelist.include(\"src/*.c\")",
      )
      write_file(path, contents)
    }
  }
}

///|
async fn update_swift_package(path : String) -> Unit {
  let contents = read_file(path)
  let replaced_contents = contents
    .replace_all(
      old="https://github.com/ChimeHQ/SwiftTreeSitter",
      new="https://github.com/tree-sitter/swift-tree-sitter",
    )
    .replace_all(
      old="// swift-tools-version:5.3",
      new="// swift-tools-version:5.6",
    )
    .replace_all(
      old="\nvar sources =",
      new="\nlet dir = Context.packageDirectory\nvar sources =",
    )
    .replace_all(
      old="atPath: \"src/scanner.c\"",
      new="atPath: \"\\(dir)/src/scanner.c\"",
    )
    .replace_all(old="version: \"0.8.0\")", new="version: \"0.10.0\")")
    .replace_all(old="version: \"0.9.0\")", new="version: \"0.10.0\")")
    .replace_all(old="(name: \"SwiftTreeSitter\", url:", new="(url:")
    .replace_all(
      old="    \"SwiftTreeSitter\"",
      new="    .product(name: \"SwiftTreeSitter\", package: \"swift-tree-sitter\")",
    )
  if replaced_contents != contents {
    @support.log_info("Updating Package.swift")
    write_file(path, replaced_contents)
  }
}

///|
async fn regenerate_if_missing(
  path : String,
  marker : String,
  template : String,
  language_name : String,
  opts : GenerateOpts,
) -> Unit {
  let contents = read_file(path)
  if !contents.contains(marker) {
    let filename = @support.file_name(path).unwrap()
    @support.log_info("Replacing \{filename}")
    generate_file(path, template, language_name, opts)
  }
}

// `get_root_path` is not ported: nothing in the CLI calls it.

///|
async fn generate_file(
  path : String,
  template : String,
  language_name : String,
  generate_opts : GenerateOpts,
) -> Unit {
  let filename = @support.file_name(path).unwrap()
  let lower_parser_name = if @support.extension(path) is Some(e) &&
    rust_to_lowercase(e) == "java" {
    to_snake_case(language_name).replace_all(old="_", new="")
  } else {
    to_snake_case(language_name)
  }
  let mut replacement = replace_query_paths(
    template
    .replace_all(
      old=CAMEL_PARSER_NAME_PLACEHOLDER,
      new=generate_opts.camel_parser_name,
    )
    .replace_all(
      old=TITLE_PARSER_NAME_PLACEHOLDER,
      new=generate_opts.title_parser_name,
    )
    .replace_all(
      old=UPPER_PARSER_NAME_PLACEHOLDER,
      new=to_shouty_snake_case(language_name),
    )
    .replace_all(
      old=KEBAB_PARSER_NAME_PLACEHOLDER,
      new=to_kebab_case(language_name),
    )
    .replace_all(old=LOWER_PARSER_NAME_PLACEHOLDER, new=lower_parser_name)
    .replace_all(old=PARSER_NAME_PLACEHOLDER, new=language_name)
    .replace_all(old=CLI_VERSION_PLACEHOLDER, new=CLI_VERSION)
    .replace_all(old=RUST_BINDING_VERSION_PLACEHOLDER, new=RUST_BINDING_VERSION)
    .replace_all(
      old=ABI_VERSION_MAX_PLACEHOLDER,
      new=ABI_VERSION_MAX.to_string(),
    )
    .replace_all(
      old=PARSER_VERSION_PLACEHOLDER,
      new=generate_opts.version.to_string(),
    )
    .replace_all(
      old=PARSER_CLASS_NAME_PLACEHOLDER,
      new=generate_opts.class_name,
    ),
    generate_opts,
  )
  if generate_opts.author_name is Some(name) {
    replacement = replacement.replace_all(old=AUTHOR_NAME_PLACEHOLDER, new=name)
  } else {
    match filename {
      "package.json" =>
        replacement = replacement.replace_all(
          old=AUTHOR_NAME_PLACEHOLDER_JS,
          new="",
        )
      "pyproject.toml" =>
        replacement = replacement.replace_all(
          old=AUTHOR_NAME_PLACEHOLDER_PY,
          new="",
        )
      "grammar.js" =>
        replacement = replacement.replace_all(
          old=AUTHOR_NAME_PLACEHOLDER_GRAMMAR,
          new="",
        )
      "Cargo.toml" =>
        replacement = replacement.replace_all(
          old=AUTHOR_NAME_PLACEHOLDER_RS,
          new="",
        )
      "pom.xml" =>
        replacement = replacement.replace_all(
          old=AUTHOR_NAME_PLACEHOLDER_JAVA,
          new="",
        )
      _ => ()
    }
  }
  if generate_opts.author_email is Some(email) {
    replacement = match filename {
      "Cargo.toml" | "grammar.js" =>
        replacement.replace_all(old=AUTHOR_EMAIL_PLACEHOLDER, new="<\{email}>")
      _ => replacement.replace_all(old=AUTHOR_EMAIL_PLACEHOLDER, new=email)
    }
  } else {
    match filename {
      "package.json" =>
        replacement = replacement.replace_all(
          old=AUTHOR_EMAIL_PLACEHOLDER_JS,
          new="",
        )
      "pyproject.toml" =>
        replacement = replacement.replace_all(
          old=AUTHOR_EMAIL_PLACEHOLDER_PY,
          new="",
        )
      "grammar.js" =>
        replacement = replacement.replace_all(
          old=AUTHOR_EMAIL_PLACEHOLDER_GRAMMAR,
          new="",
        )
      "Cargo.toml" =>
        replacement = replacement.replace_all(
          old=AUTHOR_EMAIL_PLACEHOLDER_RS,
          new="",
        )
      "pom.xml" =>
        replacement = replacement.replace_all(
          old=AUTHOR_EMAIL_PLACEHOLDER_JAVA,
          new="",
        )
      _ => ()
    }
  }
  match (generate_opts.author_url, filename) {
    (Some(url), "package.json" | "pom.xml") =>
      replacement = replacement.replace_all(old=AUTHOR_URL_PLACEHOLDER, new=url)
    (None, "package.json") =>
      replacement = replacement.replace_all(
        old=AUTHOR_URL_PLACEHOLDER_JS,
        new="",
      )
    (None, "pom.xml") =>
      replacement = replacement.replace_all(
        old=AUTHOR_URL_PLACEHOLDER_JAVA,
        new="",
      )
    _ => ()
  }
  if generate_opts.author_name is None &&
    generate_opts.author_email is None &&
    generate_opts.author_url is None {
    match filename {
      "package.json" =>
        replacement = remove_block(replacement, AUTHOR_BLOCK_JS, "},", 2)
      "pom.xml" =>
        replacement = remove_block(
          replacement,
          AUTHOR_BLOCK_JAVA,
          "</developer>",
          12,
        )
      _ => ()
    }
  } else if generate_opts.author_name is None &&
    generate_opts.author_email is None {
    match filename {
      "pyproject.toml" =>
        replacement = remove_block(replacement, AUTHOR_BLOCK_PY, "}]", 2)
      "grammar.js" =>
        replacement = remove_block(replacement, AUTHOR_BLOCK_GRAMMAR, " \n", 1)
      "Cargo.toml" =>
        replacement = remove_block(replacement, AUTHOR_BLOCK_RS, "\"]", 2)
      _ => ()
    }
  }
  if generate_opts.license is Some(license) {
    replacement = replacement.replace_all(
      old=PARSER_LICENSE_PLACEHOLDER,
      new=license,
    )
  } else {
    replacement = replacement.replace_all(
      old=PARSER_LICENSE_PLACEHOLDER,
      new="MIT",
    )
  }
  if generate_opts.description is Some(description) {
    replacement = replacement.replace_all(
      old=PARSER_DESCRIPTION_PLACEHOLDER,
      new=description,
    )
  } else {
    replacement = replacement.replace_all(
      old=PARSER_DESCRIPTION_PLACEHOLDER,
      new="\{generate_opts.camel_parser_name} grammar for tree-sitter",
    )
  }
  if generate_opts.repository is Some(repository) {
    replacement = replacement
      .replace_all(
        old=PARSER_URL_STRIPPED_PLACEHOLDER,
        new=repository.replace_all(old="https://", new=""),
      )
      .replace_all(old=PARSER_URL_PLACEHOLDER, new=repository)
  } else {
    replacement = replacement
      .replace_all(
        old=PARSER_URL_STRIPPED_PLACEHOLDER,
        new="github.com/tree-sitter/tree-sitter-\{language_name}",
      )
      .replace_all(
        old=PARSER_URL_PLACEHOLDER,
        new="https://github.com/tree-sitter/tree-sitter-\{language_name}",
      )
  }
  if generate_opts.namespace is Some(namespace) {
    replacement = replacement
      .replace_all(
        old=PARSER_NS_CLEANED_PLACEHOLDER,
        new=namespace.replace_all(old="-", new="").replace_all(old="_", new=""),
      )
      .replace_all(old=PARSER_NS_PLACEHOLDER, new=namespace)
  } else {
    replacement = replacement
      .replace_all(
        old=PARSER_NS_CLEANED_PLACEHOLDER,
        new="io.github.treesitter",
      )
      .replace_all(old=PARSER_NS_PLACEHOLDER, new="io.github.tree-sitter")
  }
  if generate_opts.funding is Some(funding_url) {
    match filename {
      "pyproject.toml" | "package.json" =>
        replacement = replacement.replace_all(
          old=FUNDING_URL_PLACEHOLDER,
          new=funding_url,
        )
      _ => ()
    }
  } else {
    match filename {
      "package.json" =>
        replacement = replacement.replace_all(
          old="  \"funding\": \"FUNDING_URL\",\n",
          new="",
        )
      "pyproject.toml" =>
        replacement = replacement.replace_all(
          old="Funding = \"FUNDING_URL\"\n",
          new="",
        )
      _ => ()
    }
  }
  if filename == "build.zig.zon" {
    let id = random_id()
    let checksum = crc32(@support.utf8("tree_sitter_\{language_name}"))
    // `#[cfg(target_endian = "little")]`
    replacement = replacement.replace_all(
      old=PARSER_FINGERPRINT_PLACEHOLDER,
      new="0x\{checksum.to_string(radix=16)}\{id.to_string(radix=16)}",
    )
  }
  write_file(path, replacement)
}

///|
/// `if let Some(start_idx) = replacement.find(block) && let Some(end_idx) =
/// replacement[start_idx..].find(end).map(|i| i + start_idx + skip) {
/// replacement.replace_range(start_idx..end_idx, "") }`.
fn remove_block(
  replacement : String,
  block : String,
  end : String,
  skip : Int32,
) -> String {
  guard replacement.find(block) is Some(start_idx) else { return replacement }
  guard replacement.view(start_offset=start_idx).find(end) is Some(i) else {
    return replacement
  }
  let end_idx = i + start_idx + skip
  replacement.view(end_offset=start_idx).to_owned() +
  replacement.view(start_offset=end_idx).to_owned()
}

///|
/// `rand::rng().random_range(1u32..0xFFFF_FFFFu32)`.
fn random_id() -> UInt32 {
  let seed = FixedArray::make(32, b'\x00')
  let mut t = @support.now_ns().reinterpret_as_uint64()
  for i in 0..<8 {
    seed[i] = (t & 0xFF).to_byte()
    t = t >> 8
  }
  let rng = @random.Rand::chacha8(seed=Bytes::from_array(seed))
  rng.uint(limit=0xFFFF_FFFEU) + 1
}

///|
async fn create_dir(path : String) -> Unit {
  create_dir_all(path) catch {
    IoError(e) =>
      raise with_context(e, "Failed to create \{@loader.rust_debug_str(path)}")
  }
}

///|
priv enum PathState {
  Exists(String)
  Missing(String)
}

///|
async fn PathState::apply(
  self : PathState,
  action : async (String) -> Unit,
) -> PathState {
  action(self.as_path())
  self
}

///|
fn PathState::as_path(self : PathState) -> String {
  match self {
    Exists(path) | Missing(path) => path
  }
}

///|
async fn missing_path(
  path : String,
  action : async (String) -> Unit,
) -> PathState {
  if !path_exists(path) {
    action(path)
    Missing(path)
  } else {
    Exists(path)
  }
}

///|
async fn missing_path_else(
  path : String,
  allow_update : Bool,
  action : async (String) -> Unit,
  else_action : async (String) -> Unit,
) -> PathState {
  if !path_exists(path) {
    action(path)
    Missing(path)
  } else {
    if allow_update {
      else_action(path)
    }
    Exists(path)
  }
}
