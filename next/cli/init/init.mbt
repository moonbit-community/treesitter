// Port of tree-sitter crates/cli/src/init.rs.
//
// The templates (`include_str!("./templates/...")`) are in templates.mbt,
// generated by tools/next/gen_init_templates.py. `anyhow::Error`s are
// `InitError`s carrying the chain of messages, outermost first.

///|
/// An `anyhow::Error` raised by `generate_grammar_files` or `run_init`: the
/// message and its causes, outermost first (as `next/cli`'s `CliError`).
pub(all) suberror InitError {
  InitError(Array[String])
} derive(Debug)

///|
pub impl Show for InitError with fn output(self, logger) {
  let InitError(chain) = self
  logger.write_string(chain.get(0).unwrap_or(""))
}

///|
/// `anyhow!(message)`.
fn anyhow(message : String) -> InitError {
  InitError([message])
}

///|
/// `Context::with_context` on an `io::Error` given as its display text.
fn with_context(message : String, context : String) -> InitError {
  InitError([context, message])
}

