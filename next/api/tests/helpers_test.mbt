// Test helpers: loading the fixture languages.
//
// `json` and a few small upstream test grammars are committed under
// testdata/. The other fixture grammars (generated by the pinned upstream CLI
// and converted with tools/next/language_from_c.py, see
// tools/next/ref_generate.sh and tools/next/diff_runtime.py) are read from
// `_build/reflang/fixture_<name>.json` (or `_build/reflang/<name>.json` for
// test grammars); tests that need one are skipped with a notice when it is
// missing, and so are tests that parse a grammar whose external scanner has
// not been ported to next/scanners yet.

///|
let language_cache : Map[String, @api.Language] = Map([])

///|
let missing_languages : Map[String, Bool] = Map([])

///|
async fn read_first(paths : Array[String]) -> String? {
  for path in paths {
    if @fs.exists(path) {
      return Some(@fs.read_file(path).text())
    }
  }
  None
}

///|
/// The fixture language `name`, or `None` (with a notice) when its tables
/// are not available.
async fn get_language(name : String) -> @api.Language? {
  if language_cache.get(name) is Some(language) {
    return Some(language)
  }
  let file = "fixture_\{name}.json"
  let candidates = [
    "next/api/tests/testdata/\{name}.json",
    "testdata/\{name}.json",
    "_build/reflang/\{file}",
    "../../../_build/reflang/\{file}",
    // upstream test grammars (test/fixtures/test_grammars)
    "_build/reflang/\{name}.json",
    "../../../_build/reflang/\{name}.json",
  ]
  guard read_first(candidates) is Some(text) else {
    if !missing_languages.contains(name) {
      missing_languages[name] = true
      println("note: skipping tests that need the `\{name}` fixture language")
    }
    return None
  }
  let raw : @language.Language = @json.from_json(@json.parse(text))
  let scanner = if raw.external_token_count > 0 {
    @scanners.scanner_for(raw.name)
  } else {
    None
  }
  let language = match scanner {
    Some(scanner) => @api.Language::new(raw, external_scanner=scanner)
    None => @api.Language::new(raw)
  }
  language_cache[name] = language
  Some(language)
}

///|
/// Grammars whose external scanner has been ported to `next/scanners` (the
/// registry still contains placeholders for the others, which abort).
let ported_scanners : Array[String] = ["bash", "ruby", "python", "cpp", "jsdoc"]

///|
/// Like [`get_language`], but `None` (with a notice) when the language
/// cannot be used for parsing yet because its external scanner is pending.
async fn get_parsing_language(name : String) -> @api.Language? {
  guard get_language(name) is Some(language) else { return None }
  if language.raw().external_token_count > 0 && !ported_scanners.contains(name) {
    if !missing_languages.contains(name) {
      missing_languages[name] = true
      println(
        "note: skipping tests that parse `\{name}` (external scanner pending)",
      )
    }
    return None
  }
  Some(language)
}

///|
fn utf8(s : String) -> Bytes {
  @utf8.encode(s)
}

///|
/// The UTF-8 text of `node` in `source`.
fn text(node : @api.Node, source : Bytes) -> String {
  try! node.utf8_text(source)
}

///|
fn parser_for(language : @api.Language) -> @api.Parser raise {
  let parser = @api.Parser::new()
  parser.set_language(language)
  parser
}

///|
fn parse(parser : @api.Parser, text : String) -> @api.Tree raise {
  match parser.parse(utf8(text)) {
    Some(tree) => tree
    None => fail("parse failed")
  }
}

///|
/// The point at a byte offset of `text`.
fn position_for_offset(text : Bytes, offset : Int32) -> @api.Point {
  let mut row = 0
  let mut column = 0
  for i in 0..<offset {
    if text[i] == b'\n' {
      row += 1
      column = 0
    } else {
      column += 1
    }
  }
  { row, column, }
}

///|
/// Replace `deleted_length` bytes at `position` with `inserted`, returning the
/// edit (upstream's `helpers::edits::perform_edit`).
fn perform_edit(
  tree : @api.Tree,
  input : Array[Byte],
  position : Int32,
  deleted_length : Int32,
  inserted : String,
) -> @api.InputEdit {
  let old_bytes = Bytes::from_array(input)
  let start_position = position_for_offset(old_bytes, position)
  let old_end_position = position_for_offset(
    old_bytes,
    position + deleted_length,
  )
  let inserted_bytes = utf8(inserted)
  for _ in 0..<deleted_length {
    ignore(input.remove(position))
  }
  for i, b in inserted_bytes {
    input.insert(position + i, b)
  }
  let new_bytes = Bytes::from_array(input)
  let edit : @api.InputEdit = {
    start_byte: position,
    old_end_byte: position + deleted_length,
    new_end_byte: position + inserted_bytes.length(),
    start_position,
    old_end_position,
    new_end_position: position_for_offset(
      new_bytes,
      position + inserted_bytes.length(),
    ),
  }
  tree.edit(edit)
  edit
}

///|
/// Lexicographic string comparison (MoonBit's `String` ordering compares
/// lengths first).
fn lex_compare(a : String, b : String) -> Int32 {
  let n = if a.length() < b.length() { a.length() } else { b.length() }
  for i in 0..<n {
    if a[i] != b[i] {
      return a[i].to_int() - b[i].to_int()
    }
  }
  a.length() - b.length()
}
