pub fn TokenSet::len(Self) -> Int32
pub fn TokenSet::new() -> Self
pub fn TokenSet::remove(Self, Symbol) -> Bool
pub fn TokenSet::terminal_bits_words(Self) -> Array[UInt64]
pub fn TokenSet::terminals(Self) -> Array[Int32]
pub impl Compare for TokenSet
pub impl Eq for TokenSet
pub impl Hash for TokenSet
pub impl @debug.Debug for TokenSet

pub(all) struct Variable {
  name : StrId
  root : RuleId
} derive(Eq, @debug.Debug)

pub(all) struct VariableInfo {
  mut fields : Map[StrId, FieldInfo]
  mut children : FieldInfo
  mut children_without_fields : FieldInfo
  mut has_multi_step_production : Bool
} derive(Eq, @debug.Debug)
pub impl Default for VariableInfo

pub(all) enum VariableType {
  Hidden
  Auxiliary
  Anonymous
  Named
} derive(Compare, Eq, Hash, @debug.Debug)
pub fn VariableType::is_visible(Self) -> Bool

// Type aliases
pub type AliasMap = @sorted_map.SortedMap[Symbol, Alias]

pub type NonterminalEntries = ParseStateEntries[GotoAction]

pub type TerminalEntries = ParseStateEntries[ActionListId]

// Traits
