// Port of tree-sitter crates/generate/src/render.rs: the `add_*` methods that
// print `parser.c`, reading the tables computed in render_tables.mbt.

///|
priv struct CWriter {
  buffer : StringBuilder
  mut indent_level : Int32
}

///|
fn CWriter::new() -> CWriter {
  { buffer: StringBuilder(), indent_level: 0, }
}

///|
/// `add!`.
fn CWriter::add(self : CWriter, s : String) -> Unit {
  self.buffer.write_string(s)
}

///|
/// `add_whitespace!`.
fn CWriter::add_whitespace(self : CWriter) -> Unit {
  for _ in 0..<self.indent_level {
    self.buffer.write_string("  ")
  }
}

///|
/// `add_line!`.
fn CWriter::add_line(self : CWriter, s : String) -> Unit {
  self.add_whitespace()
  self.buffer.write_string(s)
  self.buffer.write_string("\n")
}

///|
/// `indent!`.
fn CWriter::indent(self : CWriter) -> Unit {
  self.indent_level += 1
}

///|
/// `dedent!`.
fn CWriter::dedent(self : CWriter) -> Unit {
  guard! self.indent_level != 0
  self.indent_level -= 1
}

///|
/// `Generator::add_character`.
fn CWriter::add_character(self : CWriter, c : Int32) -> Unit {
  match c {
    '\'' => self.add("'\\''")
    '\\' => self.add("'\\\\'")
    '\u{c}' => self.add("'\\f'")
    '\n' => self.add("'\\n'")
    '\t' => self.add("'\\t'")
    '\r' => self.add("'\\r'")
    _ =>
      if c == 0 {
        self.add("0")
      } else if c >= 0x20 && c <= 0x7E {
        // `c == ' ' || c.is_ascii_graphic()`
        self.add("'\{Int::unsafe_to_char(c)}'")
      } else {
        self.add("0x\{Generator::hex(c, 2)}")
      }
  }
}

///|
/// Upstream `Generator::generate`, printing.
fn RenderedParser::print_c(self : RenderedParser) -> String {
  let w = CWriter::new()
  self.add_header(w)
  self.add_includes(w)
  self.add_pragmas(w)
  self.add_stats(w)
  self.add_symbol_enum(w)
  self.add_symbol_names_list(w)
  self.add_unique_symbol_map(w)
  self.add_symbol_metadata_list(w)
  if !self.field_names.is_empty() {
    self.add_field_name_enum(w)
    self.add_field_name_names_list(w)
    self.add_field_sequences(w)
  }
  if self.production_id_count > 0 {
    self.add_alias_sequences(w)
  }
  self.add_non_terminal_alias_map(w)
  self.add_primary_state_id_list(w)
  if self.abi_version >= abi_version_with_reserved_words &&
    !self.supertype_rows.is_empty() {
    self.add_supertype_map(w)
  }

  // Upstream prints the lex functions, then inserts the constants of the large
  // character sets they used before them.
  let lex_functions = CWriter::new()
  lex_functions.indent_level = w.indent_level
  let is_used = Array::make(self.large_character_set_names.length(), false)
  self.add_lex_function(lex_functions, "ts_lex", self.lex_fn, is_used)
  if self.keyword_lex_fn is Some(keyword_lex_fn) {
    self.add_lex_function(
      lex_functions, "ts_lex_keywords", keyword_lex_fn, is_used,
    )
  }
  for ix in 0..<self.large_character_set_names.length() {
    self.add_character_set(w, ix, is_used)
  }
  w.add(lex_functions.buffer.to_string())
  self.add_lex_modes(w)
  if self.abi_version >= abi_version_with_reserved_words &&
    self.reserved_word_sets.length() > 1 {
    self.add_reserved_word_sets(w)
  }
  self.add_parse_table(w)
  if self.external_token_count > 0 {
    self.add_external_token_enum(w)
    self.add_external_scanner_symbol_map(w)
    self.add_external_scanner_states_list(w)
  }
  self.add_parser_export(w)
  w.buffer.to_string()
}

///|
fn RenderedParser::add_header(_self : RenderedParser, w : CWriter) -> Unit {
  w.add_line("/* Automatically @generated by tree-sitter */")
  w.add_line("")
}

///|
fn RenderedParser::add_includes(_self : RenderedParser, w : CWriter) -> Unit {
  w.add_line("#include \"tree_sitter/parser.h\"")
  w.add_line("")
}

///|
fn RenderedParser::add_pragmas(self : RenderedParser, w : CWriter) -> Unit {
  w.add_line("#if defined(__GNUC__) || defined(__clang__)")
  w.add_line("#pragma GCC diagnostic ignored \"-Wmissing-field-initializers\"")
  w.add_line("#endif")
  w.add_line("")

  // Compiling large lexer functions with optimization can be very slow, so
  // disable most optimizations for large lexers. GCC 15 and later also
  // disable jump tables at O0, which makes the lexer much slower at runtime.
  if self.lex_fn.states.length() > 300 {
    w.add_line("#ifdef _MSC_VER")
    w.add_line("#pragma optimize(\"\", off)")
    w.add_line("#elif defined(__clang__)")
    w.add_line("#pragma clang optimize off")
    w.add_line("#elif defined(__GNUC__)")
    w.add_line("#pragma GCC optimize (\"O0\", \"jump-tables\")")
    w.add_line("#endif")
    w.add_line("")
  }
}

///|
fn RenderedParser::add_stats(self : RenderedParser, w : CWriter) -> Unit {
  w.add_line("#define LANGUAGE_VERSION \{self.abi_version}")
  w.add_line("#define STATE_COUNT \{self.state_count}")
  w.add_line("#define LARGE_STATE_COUNT \{self.large_state_count}")
  w.add_line("#define SYMBOL_COUNT \{self.symbol_count}")
  w.add_line("#define ALIAS_COUNT \{self.alias_count}")
  w.add_line("#define TOKEN_COUNT \{self.token_count}")
  w.add_line("#define EXTERNAL_TOKEN_COUNT \{self.external_token_count}")
  w.add_line("#define FIELD_COUNT \{self.field_names.length()}")
  w.add_line(
    "#define MAX_ALIAS_SEQUENCE_LENGTH \{self.max_alias_sequence_length}",
  )
  w.add_line(
    "#define MAX_RESERVED_WORD_SET_SIZE \{self.max_reserved_word_set_size}",
  )
  w.add_line("#define PRODUCTION_ID_COUNT \{self.production_id_count}")
  w.add_line("#define SUPERTYPE_COUNT \{self.supertype_rows.length()}")
  w.add_line("")
}

///|
fn RenderedParser::add_symbol_enum(self : RenderedParser, w : CWriter) -> Unit {
  w.add_line("enum ts_symbol_identifiers {")
  w.indent()
  for value in self.symbol_values {
    if value != 0 {
      w.add_line("\{self.idents[value]} = \{value},")
    }
  }
  for value in self.symbol_count..<(self.symbol_count + self.alias_count) {
    w.add_line("\{self.idents[value]} = \{value},")
  }
  w.dedent()
  w.add_line("};")
  w.add_line("")
}

///|
fn RenderedParser::add_symbol_names_list(
  self : RenderedParser,
  w : CWriter,
) -> Unit {
  w.add_line("static const char * const ts_symbol_names[] = {")
  w.indent()
  for value in self.symbol_values {
    w.add_line(
      "[\{self.idents[value]}] = \"\{Generator::sanitize_str(self.symbol_names[value])}\",",
    )
  }
  for value in self.symbol_count..<(self.symbol_count + self.alias_count) {
    w.add_line(
      "[\{self.idents[value]}] = \"\{Generator::sanitize_str(self.symbol_names[value])}\",",
    )
  }
  w.dedent()
  w.add_line("};")
  w.add_line("")
}

///|
fn RenderedParser::add_unique_symbol_map(
  self : RenderedParser,
  w : CWriter,
) -> Unit {
  w.add_line("static const TSSymbol ts_symbol_map[] = {")
  w.indent()
  for value in self.symbol_values {
    w.add_line(
      "[\{self.idents[value]}] = \{self.idents[self.public_symbol_map[value]]},",
    )
  }
  for value in self.symbol_count..<(self.symbol_count + self.alias_count) {
    w.add_line(
      "[\{self.idents[value]}] = \{self.idents[self.public_symbol_map[value]]},",
    )
  }
  w.dedent()
  w.add_line("};")
  w.add_line("")
}

///|
fn RenderedParser::add_field_name_enum(
  self : RenderedParser,
  w : CWriter,
) -> Unit {
  w.add_line("enum ts_field_identifiers {")
  w.indent()
  for i, field_name in self.field_names {
    w.add_line("\{Generator::field_id(field_name)} = \{i + 1},")
  }
  w.dedent()
  w.add_line("};")
  w.add_line("")
}

///|
fn RenderedParser::add_field_name_names_list(
  self : RenderedParser,
  w : CWriter,
) -> Unit {
  w.add_line("static const char * const ts_field_names[] = {")
  w.indent()
  w.add_line("[0] = NULL,")
  for field_name in self.field_names {
    w.add_line("[\{Generator::field_id(field_name)}] = \"\{field_name}\",")
  }
  w.dedent()
  w.add_line("};")
  w.add_line("")
}

///|
fn RenderedParser::add_symbol_metadata_list(
  self : RenderedParser,
  w : CWriter,
) -> Unit {
  w.add_line("static const TSSymbolMetadata ts_symbol_metadata[] = {")
  w.indent()
  let print = (value : Int32) => {
    let metadata = self.symbol_metadata[value]
    w.add_line("[\{self.idents[value]}] = {")
    w.indent()
    w.add_line(".visible = \{metadata.visible},")
    w.add_line(".named = \{metadata.named},")
    if metadata.supertype {
      w.add_line(".supertype = true,")
    }
    w.dedent()
    w.add_line("},")
  }
  for value in self.symbol_values {
    print(value)
  }
  for value in self.symbol_count..<(self.symbol_count + self.alias_count) {
    print(value)
  }
  w.dedent()
  w.add_line("};")
  w.add_line("")
}

///|
fn RenderedParser::add_alias_sequences(
  self : RenderedParser,
  w : CWriter,
) -> Unit {
  w.add_line(
    "static const TSSymbol ts_alias_sequences[PRODUCTION_ID_COUNT][MAX_ALIAS_SEQUENCE_LENGTH] = {",
  )
  w.indent()
  for i, alias_sequence in self.alias_sequences {
    if alias_sequence.is_empty() {
      // Work around MSVC's intolerance of empty array initializers by
      // explicitly zero-initializing the first element.
      if i == 0 {
        w.add_line("[0] = {0},")
      }
      continue
    }
    w.add_line("[\{i}] = {")
    w.indent()
    for j, alias in alias_sequence {
      if alias is Some(alias) {
        w.add_line("[\{j}] = \{self.idents[alias]},")
      }
    }
    w.dedent()
    w.add_line("},")
  }
  w.dedent()
  w.add_line("};")
  w.add_line("")
}

///|
fn RenderedParser::add_non_terminal_alias_map(
  self : RenderedParser,
  w : CWriter,
) -> Unit {
  w.add_line("static const uint16_t ts_non_terminal_alias_map[] = {")
  w.indent()
  for entry in self.alias_map {
    let (symbol, public_symbol, alias_ids) = entry
    w.add_line("\{self.idents[symbol]}, \{1 + alias_ids.length()},")
    w.indent()
    w.add_line("\{self.idents[public_symbol]},")
    for alias_id in alias_ids {
      w.add_line("\{self.idents[alias_id]},")
    }
    w.dedent()
  }
  w.add_line("0,")
  w.dedent()
  w.add_line("};")
  w.add_line("")
}

///|
fn RenderedParser::add_primary_state_id_list(
  self : RenderedParser,
  w : CWriter,
) -> Unit {
  w.add_line("static const TSStateId ts_primary_state_ids[STATE_COUNT] = {")
  w.indent()
  for idx, primary_state in self.primary_state_ids {
    w.add_line("[\{idx}] = \{primary_state},")
  }
  w.dedent()
  w.add_line("};")
  w.add_line("")
}

///|
fn RenderedParser::add_field_sequences(
  self : RenderedParser,
  w : CWriter,
) -> Unit {
  w.add_line(
    "static const TSMapSlice ts_field_map_slices[PRODUCTION_ID_COUNT] = {",
  )
  w.indent()
  for production_id, slice in self.field_map_slices {
    if slice.length > 0 {
      w.add_line(
        "[\{production_id}] = {.index = \{slice.index}, .length = \{slice.length}},",
      )
    }
  }
  w.dedent()
  w.add_line("};")
  w.add_line("")
  w.add_line("static const TSFieldMapEntry ts_field_map_entries[] = {")
  w.indent()
  for row in self.field_map_rows {
    let (row_index, entries) = row
    w.add_line("[\{row_index}] =")
    w.indent()
    for entry in entries {
      w.add_whitespace()
      w.add(
        "{\{Generator::field_id(self.field_names[entry.field_id - 1])}, \{entry.child_index}",
      )
      if entry.inherited {
        w.add(", .inherited = true")
      }
      w.add("},\n")
    }
    w.dedent()
  }
  w.dedent()
  w.add_line("};")
  w.add_line("")
}

///|
fn RenderedParser::add_supertype_map(
  self : RenderedParser,
  w : CWriter,
) -> Unit {
  w.add_line("static const TSSymbol ts_supertype_symbols[SUPERTYPE_COUNT] = {")
  w.indent()
  for row in self.supertype_rows {
    w.add_line("\{self.idents[row.0]},")
  }
  w.dedent()
  w.add_line("};\n")
  w.add_line("static const TSMapSlice ts_supertype_map_slices[] = {")
  w.indent()
  let mut row_id = 0
  let supertype_ids = [0]
  for row in self.supertype_rows {
    let (supertype, subtypes) = row
    let length = subtypes.length()
    w.add_line(
      "[\{self.idents[supertype]}] = {.index = \{row_id}, .length = \{length}},",
    )
    row_id += length
    supertype_ids.push(row_id)
  }
  w.dedent()
  w.add_line("};")
  w.add_line("")
  w.add_line("static const TSSymbol ts_supertype_map_entries[] = {")
  w.indent()
  for i, row in self.supertype_rows {
    let row_index = supertype_ids[i]
    w.add_line("[\{row_index}] =")
    w.indent()
    for subtype in row.1 {
      w.add_whitespace()
      w.add("\{self.idents[subtype]},\n")
    }
    w.dedent()
  }
  w.dedent()
  w.add_line("};")
  w.add_line("")
}

///|
fn RenderedParser::add_lex_function(
  self : RenderedParser,
  w : CWriter,
  name : String,
  lex_fn : @language.LexProgram,
  is_used : Array[Bool],
) -> Unit {
  w.add_line("static bool \{name}(TSLexer *lexer, TSStateId state) {")
  w.indent()
  w.add_line("START_LEXER();")
  w.add_line("eof = lexer->eof(lexer);")
  w.add_line("switch (state) {")
  w.indent()
  for i, state in lex_fn.states {
    w.add_line("case \{i}:")
    w.indent()
    self.add_lex_state(w, lex_fn, state, is_used)
    w.dedent()
  }
  w.add_line("default:")
  w.indent()
  w.add_line("return false;")
  w.dedent()
  w.dedent()
  w.add_line("}")
  w.dedent()
  w.add_line("}")
  w.add_line("")
}

///|
fn RenderedParser::add_lex_state(
  self : RenderedParser,
  w : CWriter,
  lex_fn : @language.LexProgram,
  state : @language.LexStateCode,
  is_used : Array[Bool],
) -> Unit {
  if state.accept_token is Some(accept_action) {
    w.add_line("ACCEPT_TOKEN(\{self.idents[accept_action]});")
  }
  if state.eof_advance is Some(eof_state) {
    w.add_line("if (eof) ADVANCE(\{eof_state});")
  }
  if !state.advance_map.is_empty() {
    w.add_line("ADVANCE_MAP(")
    w.indent()
    for entry in state.advance_map {
      let (c, next_state) = entry
      w.add_whitespace()
      w.add_character(c)
      w.add(", \{next_state},\n")
    }
    w.dedent()
    w.add_line(");")
  }
  for transition in state.transitions {
    w.add_whitespace()
    let condition = transition.condition
    let line_break = "\n" + "  ".repeat(w.indent_level + 2)
    let has_positive_condition = condition.large_set is Some(_) ||
      condition.asserted is Some(_)
    let has_negative_condition = condition.negated is Some(_)
    let has_condition = has_positive_condition || has_negative_condition
    if has_condition {
      w.add("if (")
      if has_positive_condition && has_negative_condition {
        w.add("(")
      }
    }
    if condition.large_set is Some((large_char_set_ix, check_eof)) {
      if check_eof {
        w.add("(!eof && ")
      }
      is_used[large_char_set_ix] = true
      w.add(
        "set_contains(\{self.large_character_set_names[large_char_set_ix]}, \{lex_fn.large_character_sets[large_char_set_ix].length()}, lookahead)",
      )
      if check_eof {
        w.add(")")
      }
    }
    if condition.asserted is Some(asserted) {
      if condition.large_set is Some(_) {
        w.add(" ||\{line_break}")
      }
      w.add_character_range_conditions(
        asserted.ranges,
        asserted.is_included,
        line_break,
      )
    }
    if condition.negated is Some(negated) {
      if has_positive_condition {
        w.add(") &&\{line_break}")
      }
      w.add_character_range_conditions(
        negated.ranges,
        negated.is_included,
        line_break,
      )
    }
    if has_condition {
      w.add(") ")
    }
    if transition.skip {
      w.add("SKIP(\{transition.state});")
    } else {
      w.add("ADVANCE(\{transition.state});")
    }
    w.add("\n")
  }
  w.add_line("END_STATE();")
}

///|
fn CWriter::add_character_range_conditions(
  self : CWriter,
  characters : Array[@language.CharacterRange],
  is_included : Bool,
  line_break : String,
) -> Unit {
  for i, range in characters {
    let start = range.start
    let end = range.end
    if is_included {
      if i > 0 {
        self.add(" ||\{line_break}")
      }
      if start == 0 {
        self.add("(!eof && ")
        if end == 0 {
          self.add("lookahead == 0")
        } else {
          self.add("lookahead <= ")
        }
        self.add_character(end)
        self.add(")")
      } else if end == start {
        self.add("lookahead == ")
        self.add_character(start)
      } else if end == start + 1 {
        self.add("lookahead == ")
        self.add_character(start)
        self.add(" ||\{line_break}lookahead == ")
        self.add_character(end)
      } else {
        self.add("(")
        self.add_character(start)
        self.add(" <= lookahead && lookahead <= ")
        self.add_character(end)
        self.add(")")
      }
    } else {
      if i > 0 {
        self.add(" &&\{line_break}")
      }
      if end == start {
        self.add("lookahead != ")
        self.add_character(start)
      } else if end == start + 1 {
        self.add("lookahead != ")
        self.add_character(start)
        self.add(" &&\{line_break}lookahead != ")
        self.add_character(end)
      } else if start != 0 {
        self.add("(lookahead < ")
        self.add_character(start)
        self.add(" || ")
        self.add_character(end)
        self.add(" < lookahead)")
      } else {
        self.add("lookahead > ")
        self.add_character(end)
      }
    }
  }
}

///|
fn RenderedParser::add_character_set(
  self : RenderedParser,
  w : CWriter,
  ix : Int32,
  is_used : Array[Bool],
) -> Unit {
  if !is_used[ix] {
    return
  }
  let characters = self.lex_fn.large_character_sets[ix]
  w.add_line(
    "static const TSCharacterRange \{self.large_character_set_names[ix]}[] = {",
  )
  w.indent()
  for i, range in characters {
    let column = i % 8
    if column == 0 {
      if i > 0 {
        w.add("\n")
      }
      w.add_whitespace()
    } else {
      w.add(" ")
    }
    w.add("{")
    w.add_character(range.start)
    w.add(", ")
    w.add_character(range.end)
    w.add("},")
  }
  w.add("\n")
  w.dedent()
  w.add_line("};")
  w.add_line("")
}

///|
fn RenderedParser::add_lex_modes(self : RenderedParser, w : CWriter) -> Unit {
  w.add_line(
    "static const \{if self.abi_version >= abi_version_with_reserved_words { "TSLexerMode" } else { "TSLexMode" }} ts_lex_modes[STATE_COUNT] = {",
  )
  w.indent()
  for i, lex_mode in self.lex_modes {
    w.add_whitespace()
    w.add("[\{i}] = {")
    match lex_mode {
      None => w.add("(TSStateId)(-1),")
      Some(mode) => {
        w.add(".lex_state = \{mode.lex_state}")
        if mode.external_lex_state > 0 {
          w.add(", .external_lex_state = \{mode.external_lex_state}")
        }
        if self.abi_version >= abi_version_with_reserved_words {
          let reserved_word_set_id = mode.reserved_word_set_id
          if reserved_word_set_id != 0 {
            w.add(", .reserved_word_set_id = \{reserved_word_set_id}")
          }
        }
      }
    }
    w.add("},\n")
  }
  w.dedent()
  w.add_line("};")
  w.add_line("")
}

///|
fn RenderedParser::add_reserved_word_sets(
  self : RenderedParser,
  w : CWriter,
) -> Unit {
  w.add_line(
    "static const TSSymbol ts_reserved_words[\{self.reserved_word_sets.length()}][MAX_RESERVED_WORD_SET_SIZE] = {",
  )
  w.indent()
  for id, set in self.reserved_word_sets {
    if id == 0 {
      continue
    }
    w.add_line("[\{id}] = {")
    w.indent()
    for token in set {
      w.add_line("\{self.idents[token]},")
    }
    w.dedent()
    w.add_line("},")
  }
  w.dedent()
  w.add_line("};")
  w.add_line("")
}

///|
fn RenderedParser::add_external_token_enum(
  self : RenderedParser,
  w : CWriter,
) -> Unit {
  w.add_line("enum ts_external_scanner_symbol_identifiers {")
  w.indent()
  for i, id in self.external_token_ids {
    w.add_line("\{id} = \{i},")
  }
  w.dedent()
  w.add_line("};")
  w.add_line("")
}

///|
fn RenderedParser::add_external_scanner_symbol_map(
  self : RenderedParser,
  w : CWriter,
) -> Unit {
  w.add_line(
    "static const TSSymbol ts_external_scanner_symbol_map[EXTERNAL_TOKEN_COUNT] = {",
  )
  w.indent()
  for i, id in self.external_token_ids {
    w.add_line("[\{id}] = \{self.idents[self.external_scanner_symbol_map[i]]},")
  }
  w.dedent()
  w.add_line("};")
  w.add_line("")
}

///|
fn RenderedParser::add_external_scanner_states_list(
  self : RenderedParser,
  w : CWriter,
) -> Unit {
  w.add_line(
    "static const bool ts_external_scanner_states[\{self.external_lex_states.length()}][EXTERNAL_TOKEN_COUNT] = {",
  )
  w.indent()
  for i, externals in self.external_lex_states {
    if !externals.is_empty() {
      w.add_line("[\{i}] = {")
      w.indent()
      for index in externals {
        w.add_line("[\{self.external_token_ids[index]}] = true,")
      }
      w.dedent()
      w.add_line("},")
    }
  }
  w.dedent()
  w.add_line("};")
  w.add_line("")
}

///|
fn RenderedParser::add_parse_table(self : RenderedParser, w : CWriter) -> Unit {
  w.add_line(
    "static const uint16_t ts_parse_table[LARGE_STATE_COUNT][SYMBOL_COUNT] = {",
  )
  w.indent()
  for i, row in self.large_states {
    w.add_line("[STATE(\{i})] = {")
    w.indent()
    for entry in row.nonterminals {
      w.add_line("[\{self.idents[entry.0]}] = STATE(\{entry.1}),")
    }
    for entry in row.terminals {
      w.add_line("[\{self.idents[entry.0]}] = ACTIONS(\{entry.1}),")
    }
    w.dedent()
    w.add_line("},")
  }
  w.dedent()
  w.add_line("};")
  w.add_line("")
  if self.large_state_count < self.state_count {
    w.add_line("static const uint16_t ts_small_parse_table[] = {")
    w.indent()
    for i, groups in self.small_states {
      w.add_line("[\{self.small_state_indices[i]}] = \{groups.length()},")
      w.indent()
      for group in groups {
        if group.is_state {
          w.add_line("STATE(\{group.value}), \{group.symbols.length()},")
        } else {
          w.add_line("ACTIONS(\{group.value}), \{group.symbols.length()},")
        }
        w.indent()
        for symbol in group.symbols {
          w.add_line("\{self.idents[symbol]},")
        }
        w.dedent()
      }
      w.dedent()
    }
    w.dedent()
    w.add_line("};")
    w.add_line("")
    w.add_line("static const uint32_t ts_small_parse_table_map[] = {")
    w.indent()
    for i in self.large_state_count..<self.state_count {
      w.add_line(
        "[SMALL_STATE(\{i})] = \{self.small_state_indices[i - self.large_state_count]},",
      )
    }
    w.dedent()
    w.add_line("};")
    w.add_line("")
  }
  self.add_parse_action_list(w)
}

///|
fn RenderedParser::add_parse_action_list(
  self : RenderedParser,
  w : CWriter,
) -> Unit {
  w.add_line("static const TSParseActionEntry ts_parse_actions[] = {")
  w.indent()
  for list in self.parse_actions {
    w.add(
      "  [\{list.index}] = {.entry = {.count = \{list.actions.length()}, .reusable = \{list.reusable}}},",
    )
    for action in list.actions {
      w.add(" ")
      match action {
        Accept => w.add(" ACCEPT_INPUT()")
        Recover => w.add("RECOVER()")
        Shift(extra=true, ..) => w.add("SHIFT_EXTRA()")
        Shift(state~, repetition=true, ..) => w.add("SHIFT_REPEAT(\{state})")
        Shift(state~, ..) => w.add("SHIFT(\{state})")
        Reduce(symbol~, child_count~, dynamic_precedence~, production_id~) =>
          w.add(
            "REDUCE(\{self.idents[symbol]}, \{child_count}, \{dynamic_precedence}, \{production_id})",
          )
        Entry(..) => abort("an action list holds no entry headers")
      }
      w.add(",")
    }
    w.add("\n")
  }
  w.dedent()
  w.add_line("};")
  w.add_line("")
}

///|
fn RenderedParser::add_parser_export(
  self : RenderedParser,
  w : CWriter,
) -> Unit {
  let language_function_name = "tree_sitter_\{self.language_name}"
  let external_scanner_name = "\{language_function_name}_external_scanner"
  w.add_line("#ifdef __cplusplus")
  w.add_line("extern \"C\" {")
  w.add_line("#endif")
  if self.external_token_count > 0 {
    w.add_line("void *\{external_scanner_name}_create(void);")
    w.add_line("void \{external_scanner_name}_destroy(void *);")
    w.add_line(
      "bool \{external_scanner_name}_scan(void *, TSLexer *, const bool *);",
    )
    w.add_line("unsigned \{external_scanner_name}_serialize(void *, char *);")
    w.add_line(
      "void \{external_scanner_name}_deserialize(void *, const char *, unsigned);",
    )
    w.add_line("")
  }
  w.add_line("#ifdef TREE_SITTER_HIDE_SYMBOLS")
  w.add_line("#define TS_PUBLIC")
  w.add_line("#elif defined(_WIN32)")
  w.add_line("#define TS_PUBLIC __declspec(dllexport)")
  w.add_line("#else")
  w.add_line("#define TS_PUBLIC __attribute__((visibility(\"default\")))")
  w.add_line("#endif")
  w.add_line("")
  w.add_line("TS_PUBLIC const TSLanguage *\{language_function_name}(void) {")
  w.indent()
  w.add_line("static const TSLanguage language = {")
  w.indent()
  w.add_line(".abi_version = LANGUAGE_VERSION,")

  // Quantities
  w.add_line(".symbol_count = SYMBOL_COUNT,")
  w.add_line(".alias_count = ALIAS_COUNT,")
  w.add_line(".token_count = TOKEN_COUNT,")
  w.add_line(".external_token_count = EXTERNAL_TOKEN_COUNT,")
  w.add_line(".state_count = STATE_COUNT,")
  w.add_line(".large_state_count = LARGE_STATE_COUNT,")
  w.add_line(".production_id_count = PRODUCTION_ID_COUNT,")
  if self.abi_version >= abi_version_with_reserved_words {
    w.add_line(".supertype_count = SUPERTYPE_COUNT,")
  }
  w.add_line(".field_count = FIELD_COUNT,")
  w.add_line(".max_alias_sequence_length = MAX_ALIAS_SEQUENCE_LENGTH,")

  // Parse table
  w.add_line(".parse_table = &ts_parse_table[0][0],")
  if self.large_state_count < self.state_count {
    w.add_line(".small_parse_table = ts_small_parse_table,")
    w.add_line(".small_parse_table_map = ts_small_parse_table_map,")
  }
  w.add_line(".parse_actions = ts_parse_actions,")

  // Metadata
  w.add_line(".symbol_names = ts_symbol_names,")
  if !self.field_names.is_empty() {
    w.add_line(".field_names = ts_field_names,")
    w.add_line(".field_map_slices = ts_field_map_slices,")
    w.add_line(".field_map_entries = ts_field_map_entries,")
  }
  if !self.supertype_rows.is_empty() &&
    self.abi_version >= abi_version_with_reserved_words {
    w.add_line(".supertype_map_slices = ts_supertype_map_slices,")
    w.add_line(".supertype_map_entries = ts_supertype_map_entries,")
    w.add_line(".supertype_symbols = ts_supertype_symbols,")
  }
  w.add_line(".symbol_metadata = ts_symbol_metadata,")
  w.add_line(".public_symbol_map = ts_symbol_map,")
  w.add_line(".alias_map = ts_non_terminal_alias_map,")
  if self.production_id_count > 0 {
    w.add_line(".alias_sequences = &ts_alias_sequences[0][0],")
  }

  // Lexing
  w.add_line(".lex_modes = (const void*)ts_lex_modes,")
  w.add_line(".lex_fn = ts_lex,")
  if self.keyword_capture_token is Some(keyword_capture_token) {
    w.add_line(".keyword_lex_fn = ts_lex_keywords,")
    w.add_line(
      ".keyword_capture_token = \{self.idents[keyword_capture_token]},",
    )
  }
  if self.external_token_count > 0 {
    w.add_line(".external_scanner = {")
    w.indent()
    w.add_line("&ts_external_scanner_states[0][0],")
    w.add_line("ts_external_scanner_symbol_map,")
    w.add_line("\{external_scanner_name}_create,")
    w.add_line("\{external_scanner_name}_destroy,")
    w.add_line("\{external_scanner_name}_scan,")
    w.add_line("\{external_scanner_name}_serialize,")
    w.add_line("\{external_scanner_name}_deserialize,")
    w.dedent()
    w.add_line("},")
  }
  w.add_line(".primary_state_ids = ts_primary_state_ids,")
  if self.abi_version >= abi_version_with_reserved_words {
    w.add_line(".name = \"\{self.language_name}\",")
    if self.reserved_word_sets.length() > 1 {
      w.add_line(".reserved_words = &ts_reserved_words[0][0],")
    }
    w.add_line(
      ".max_reserved_word_set_size = \{self.max_reserved_word_set_size},",
    )
    let (major, minor, patch) = self.metadata.unwrap_or((0, 0, 0))
    w.add_line(".metadata = {")
    w.indent()
    w.add_line(".major_version = \{major},")
    w.add_line(".minor_version = \{minor},")
    w.add_line(".patch_version = \{patch},")
    w.dedent()
    w.add_line("},")
  }
  w.dedent()
  w.add_line("};")
  w.add_line("return &language;")
  w.dedent()
  w.add_line("}")
  w.add_line("#ifdef __cplusplus")
  w.add_line("}")
  w.add_line("#endif")
}
