        [",", 6, 7, 2, 1, 2, 2],
        ["number", 8, 9, 3, 0, 3, 1],
        ["]", 10, 10, 4, 0, 4, 0],
      ],
    ),
    (
      "[\n1,\n2,\n3\n]",
      7,
      7,
      "\n",
      [
        ["document", 0, 12, 0, 0, 5, 1],
        ["array", 0, 12, 0, 0, 5, 1],
        ["[", 0, 1, 0, 0, 0, 1],
        ["number", 2, 3, 1, 0, 1, 1],
        [",", 3, 4, 1, 1, 1, 2],
        ["number", 5, 6, 2, 0, 2, 1],
        [",", 6, 8, 2, 1, 3, 0],
        ["number", 9, 10, 4, 0, 4, 1],
        ["]", 11, 12, 5, 0, 5, 1],
      ],
    ),
    (
      "[\n1,\n2,\n3\n]",
      10,
      11,
      "[]",
      [
        ["document", 0, 12, 0, 0, 4, 2],
        ["array", 0, 12, 0, 0, 4, 2],
        ["[", 0, 1, 0, 0, 0, 1],
        ["number", 2, 3, 1, 0, 1, 1],
        [",", 3, 4, 1, 1, 1, 2],
        ["number", 5, 6, 2, 0, 2, 1],
        [",", 6, 7, 2, 1, 2, 2],
        ["number", 8, 9, 3, 0, 3, 1],
        ["]", 10, 12, 4, 0, 4, 2],
      ],
    ),
  ]
  for (source, start, end, replacement, expected) in cases {
    let tree = parser.parse_string(source)
    let after = @utf8.encode(source)[:start].to_owned() +
      @utf8.encode(replacement) +
      @utf8.encode(source)[end:].to_owned()
    let fresh = parser.parse(after)
    let new_end = start + @utf8.encode(replacement).length()
    tree.edit({
      start_byte: start,
      old_end_byte: end,
      new_end_byte: new_end,
      start_point: tree.point_at(start),
      old_end_point: tree.point_at(end),
      new_end_point: fresh.point_at(new_end),
    })
    let spans : Array[Json] = []
    fn visit(node : @ts.Node) {
      spans.push([
        Json(node.kind()),
        Json(node.start_byte()),
        Json(node.end_byte()),
        Json(node.start_position().row),
        Json(node.start_position().column),
        Json(node.end_position().row),
        Json(node.end_position().column),
      ])
      node.children().each(visit)
    }
    visit(tree.root_node())
    assert_eq(
      Json(spans),
      expected,
      msg="\{source} @ \{start}..\{end} -> \{replacement}",
    )
  }
}
