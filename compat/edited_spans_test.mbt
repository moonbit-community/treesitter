    (
      "[\n1,\n2,\n3\n]",
      10,
      11,
      "",
      [
        ["document", 0, 10, 0, 0, 4, 0],
        ["array", 0, 10, 0, 0, 4, 0],
        ["[", 0, 1, 0, 0, 0, 1],
        ["number", 2, 3, 1, 0, 1, 1],
        [",", 3, 4, 1, 1, 1, 2],
