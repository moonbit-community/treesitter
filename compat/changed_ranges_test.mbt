    ("[\"a\",[1,2]]", "[\"longer\",\"a\",[1,2]]", 2, 2, 11, [(2, 8), (9, 10)]),
    ("[[],1,{\"a\":[0,1]},\"a\"]", "[[],1,{\"a\":[0,1]}]", 17, 21, 17, []),
    (
      "[\"a\",1,\"longer\",100,null,1,0]",
      "[\"a\",true,1,\"longer\",100,null,1,0]",
      5,
      5,
      10,
      [(5, 9)],
    ),
    ("[\"a\",\"a\",1,[]]", "[\"a\",0,1,[]]", 5, 8, 6, [(5, 6)]),
    ("[0,[],0,[1,2]]", "[0,[],0]", 7, 13, 7, []),
    (
      "[100,0,false,{},\"longer\",0]",
      "[{},0,false,{},\"longer\",0]",
      1,
      4,
      3,
      [(1, 3)],
    ),
    ("[1,{}]", "[1,0]", 3, 5, 4, [(3, 4)]),
    ("[{},null,false,[1,2]]", "[{},null,false,false]", 15, 20, 20, [(15, 20)]),
    ("[[],100]", "[[],null,100]", 4, 4, 9, [(4, 8)]),
    ("[{},\"a\",1]", "[1,{},\"a\",1]", 1, 1, 3, [(1, 3)]),
    ("[{},100]", "[100]", 1, 4, 1, []),
    (
      "[[1,2],1,[1,2],{},\"longer\",1,{\"a\":[0,1]}]",
      "[[1,2],1,[1,2],{},\"longer\",1,[],{\"a\":[0,1]}]",
      29,
      29,
      32,
      [(29, 31)],
    ),
    ("[\"a\",null,{},1]", "[null,\"a\",null,{},1]", 1, 1, 6, [(1, 6)]),
    (
      "[{\"a\":[0,1]},false,\"longer\",true,0]",
      "[{\"a\":[0,1]},false,\"longer\",[1,2],0]",
      28,
      32,
      33,
      [(28, 33)],
    ),
    ("[\"longer\",\"longer\",true,{}]", "[\"longer\",true,{}]", 10, 19, 10, []),
    ("[true]", "[\"longer\"]", 1, 5, 9, [(1, 9)]),
    ("[[1,2]]", "[1]", 1, 6, 2, [(1, 2)]),
    ("[[1,2],[],1,1,\"longer\"]", "[1,[],1,1,\"longer\"]", 1, 6, 2, [(1, 2)]),
    ("[\"a\",1,100,true]", "[[],1,100,true]", 1, 4, 3, [(1, 3)]),
    (
      "[null,false,\"longer\",\"longer\",[]]",
      "[null,false,\"longer\",\"longer\",[]]",
      33,
      33,
      33,
      [],
    ),
    (
      "[false,[],0,0,100,[]]",
      "[false,[],[1,2],0,100,[]]",
      10,
      11,
      15,
      [(10, 15)],
    ),
    (
      "[[],0,\"longer\",\"a\",100,100,\"a\"]",
      "[[],{\"a\":[0,1]},0,\"longer\",\"a\",100,100,\"a\"]",
      4,
      4,
      16,
      [(4, 15)],
    ),
    (
      "[null,\"a\",\"longer\",[1,2],{\"a\":[0,1]}]",
      "[null,\"a\",{},[1,2],{\"a\":[0,1]}]",
      10,
      18,
      12,
      [(10, 12)],
    ),
    ("[\"a\",1]", "[\"a\"]", 4, 6, 4, []),
    ("[true,0,100,[]]", "[true,100,[]]", 6, 8, 6, []),
    ("[[1,2],[],\"a\"]", "[[1,2],[],true]", 10, 13, 14, [(10, 14)]),
    (
      "[{\"a\":[0,1]},[],0,{\"a\":[0,1]},\"a\",null,\"longer\"]",
      "[{\"a\":[0,1]},[],0,{\"a\":[0,1]},\"a\",null]",
      38,
      47,
      38,
      [],
    ),
    (
      "[{\"a\":[0,1]},{},true,\"a\",null]",
      "[{\"a\":[0,1]},{},[1,2],\"a\",null]",
      16,
      20,
      21,
      [(16, 21)],
    ),
    (
      "[false,null,0,{},1,null,\"a\"]",
      "[false,null,0,\"longer\",{},1,null,\"a\"]",
      14,
      14,
      23,
      [(14, 22)],
    ),
    (
      "[\"a\",{},\"longer\",{\"a\":[0,1]},true]",
      "[\"a\",{},{\"a\":[0,1]},true]",
      8,
      17,
      8,
      [],
    ),
    (
      "[0,null,\"a\",false,{},[]]",
      "[0,null,[1,2],false,{},[]]",
      8,
      11,
      13,
      [(8, 13)],
    ),
    (
      "[\"a\",1,null,null,{}]",
      "[\"a\",1,null,null,1,{}]",
      17,
      17,
      19,
      [(17, 18)],
    ),
    ("[0,true]", "[true]", 1, 3, 1, []),
    (
      "[null,true,null,[],\"longer\",\"a\",null]",
      "[null,true,null,[],\"longer\",\"a\",\"a\"]",
      32,
      36,
      35,
      [(32, 35)],
    ),
    (
      "[false,1,1,{\"a\":[0,1]},null,true,[]]",
      "[false,1,1,{\"a\":[0,1]},true,[]]",
      23,
      28,
      23,
      [],
    ),
    (
      "[true,true,false,true,\"longer\",false,0]",
      "[true,true,false,100,\"longer\",false,0]",
      17,
      21,
      20,
      [(17, 20)],
    ),
    (
      "[null,null,null,\"a\",[1,2],{},{}]",
      "[null,null,null,\"a\",[],[1,2],{},{}]",
      21,
      21,
      24,
      [(21, 23)],
    ),
    ("[100,[1,2],1,0,{}]", "[100,1,0,{}]", 5, 11, 5, []),
    (
      "[\"longer\",\"a\",true,\"longer\",{\"a\":[0,1]},[]]",
      "[\"longer\",\"a\",true,\"longer\",{\"a\":[0,1]},\"a\",[]]",
      40,
      40,
      44,
      [(40, 43)],
    ),
    ("[\"longer\"]", "[]", 1, 9, 1, []),
    ("[0,true,{}]", "[0,true,{}]", 11, 11, 11, []),
    (
      "[[],null,{},null,\"longer\",[],\"a\"]",
      "[[],null,{},null,\"longer\",[]]",
      28,
      32,
      28,
      [],
    ),
    ("[1,100]", "[1,{\"a\":[0,1]},100]", 3, 3, 15, [(3, 14)]),
    ("[[1,2]]", "[0]", 1, 6, 2, [(1, 2)]),
    (
      "[true,false,false,\"longer\",{\"a\":[0,1]}]",
      "[true,{},false,\"longer\",{\"a\":[0,1]}]",
      6,
      11,
      8,
      [(6, 8)],
    ),
  ]
  for (old_source, new_source, start, old_end, new_end, expected) in cases {
    let old = parser.parse_string(old_source)
    old.edit({
      start_byte: start,
      old_end_byte: old_end,
      new_end_byte: new_end,
      start_point: { row: 0, column: start, },
      old_end_point: { row: 0, column: old_end, },
      new_end_point: { row: 0, column: new_end, },
    })
    let new = parser.parse(@utf8.encode(new_source), old_tree=old)
    assert_eq(
      new.root_node().to_sexp(),
      parser.parse_string(new_source).root_node().to_sexp(),
    )
    let actual = old.changed_ranges(new).map(r => (r.start_byte, r.end_byte))
    assert_eq(actual, expected, msg="\{old_source} -> \{new_source}")
  }
}
