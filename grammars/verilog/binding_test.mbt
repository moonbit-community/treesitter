// Generated by tools/grammars/update.sh. Do not edit.

///|
test "language parses a sample" {
  let language = @tree_sitter_verilog.language()
  // Decoded once.
  assert_true(language == @tree_sitter_verilog.language())
  assert_eq(language.name(), Some("verilog"))
  assert_eq(language.abi_version(), 15)
  let parser = @treesitter.Parser::new()
  parser.set_language(language)
  let source =
    #|module identifiers();
    #|
    #|  reg \busa+index ;
    #|  reg \-clock ;
    #|  reg \***error-condition*** ;
    #|  reg \net1/\net2 ;
    #|  reg \{a,b} ;
    #|  reg \a*(b+c) ;
    #|
    #|endmodule
    #|
  guard parser.parse(@utf8.encode(source)) is Some(tree) else {
    fail("parse failed")
  }
  let sexp = tree.root_node().to_sexp()
  assert_false(sexp.contains("ERROR") || sexp.contains("MISSING"), msg=sexp)
}

///|
test "node types" {
  assert_true(@tree_sitter_verilog.node_types.has_prefix("["))
}
