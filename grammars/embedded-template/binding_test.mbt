///|
test "language parses a sample" {
  let language = @tree_sitter_embedded_template.language()
  // Decoded once.
  assert_true(language == @tree_sitter_embedded_template.language())
  assert_eq(language.name(), Some("embedded_template"))
  assert_eq(language.abi_version(), 15)
  let parser = @treesitter.Parser::new()
  parser.set_language(language)
  let source =
    #|This "<%%" is not a directive
    #|
  guard parser.parse(@utf8.encode(source)) is Some(tree) else {
    fail("parse failed")
  }
  let sexp = tree.root_node().to_sexp()
  assert_false(sexp.contains("ERROR") || sexp.contains("MISSING"), msg=sexp)
}

///|
test "language queries compile" {
  let language = @tree_sitter_embedded_template.language()
  ignore(
    @treesitter.Query::new(
      language, @tree_sitter_embedded_template.highlights_query,
    ),
  )
  ignore(
    @treesitter.Query::new(
      language, @tree_sitter_embedded_template.injections_ejs_query,
    ),
  )
  ignore(
    @treesitter.Query::new(
      language, @tree_sitter_embedded_template.injections_erb_query,
    ),
  )
}

