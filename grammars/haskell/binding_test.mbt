// Generated by tools/grammars/update.sh. Do not edit.

///|
test "language parses a sample" {
  let language = @tree_sitter_haskell.language()
  // Decoded once.
  assert_true(language == @tree_sitter_haskell.language())
  assert_eq(language.name(), Some("haskell"))
  assert_eq(language.abi_version(), 15)
  guard language.is_parseable() else {
    println("note: skipping haskell: its external scanner is not ported yet")
    return
  }
  let parser = @treesitter.Parser::new()
  parser.set_language(language)
  let source =
    #|a = 'a'
    #|a = 'b'
    #|a = '0'
    #|a = '1'
    #|a = '_'
    #|a = 'A'
    #|a = 'B'
    #|a = ','
    #|
  guard parser.parse(@utf8.encode(source)) is Some(tree) else {
    fail("parse failed")
  }
  let sexp = tree.root_node().to_sexp()
  assert_false(sexp.contains("ERROR") || sexp.contains("MISSING"), msg=sexp)
}

///|
test "language queries compile" {
  let language = @tree_sitter_haskell.language()
  ignore(
    @treesitter.Query::new(language, @tree_sitter_haskell.highlights_query),
  )
  ignore(
    @treesitter.Query::new(language, @tree_sitter_haskell.injections_query),
  )
  ignore(@treesitter.Query::new(language, @tree_sitter_haskell.locals_query))
}

///|
test "node types" {
  assert_true(@tree_sitter_haskell.node_types.has_prefix("["))
}
