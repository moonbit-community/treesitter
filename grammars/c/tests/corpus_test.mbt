// Generated by tools/grammars/update.sh. Do not edit.
//
// Parse every example of the grammar's corpus (copied from the pinned
// grammar repository) and compare the trees with the expected ones, like
// `tree-sitter test`. An example applies to the languages named by its
// `:language(...)` attributes, or else to the default language of its
// corpus directory.

///|
/// `path` (relative to the module root) from the module root, this
/// package's directory or the workspace root.
async fn find_dir(path : String) -> String? {
  for prefix in ["", "../", "grammars/c/"] {
    if @fs.exists(prefix + path) {
      return Some(prefix + path)
    }
  }
  None
}

///|
async fn check_corpus(
  language : @treesitter.Language,
  name : String,
  corpus_dirs : Array[(String, String)],
  skipped : Array[String],
) -> Unit {
  guard language.is_parseable() else {
    println(
      "note: skipping the \{name} corpus: the external scanner of \{name} is not ported yet",
    )
    return
  }
  let mut count = 0
  let mut failures = 0
  for corpus in corpus_dirs {
    let (path, default_language) = corpus
    guard find_dir(path) is Some(dir) else {
      fail("corpus directory \{path} not found")
    }
    let tests = @cli_test.flatten_tests(@cli_test.parse_tests(dir), None, None)
    for test_case in tests {
      let applies = if test_case.languages[0].is_empty() {
        default_language == name
      } else {
        test_case.languages.contains(name)
      }
      if !applies ||
        test_case.expectation is Skip ||
        skipped.contains(test_case.name) {
        continue
      }
      count += 1
      let check_output = !(test_case.expectation is Error)
      if !test_case.check_initial_parse(
          language,
          "\{name} - \{test_case.name}",
          check_output,
        ) {
        failures += 1
      }
    }
  }
  if count == 0 {
    fail("no \{name} corpus examples found")
  }
  if failures > 0 {
    fail("\{failures} of \{count} \{name} corpus examples failed")
  }
}

///|
async test "corpus of c" {
  check_corpus(@tree_sitter_c.language(), "c", [("test/corpus", "c")], [])
}
