///|
test "language_ocaml parses a sample" {
  let language = @tree_sitter_ocaml.language_ocaml()
  // Decoded once.
  assert_true(language == @tree_sitter_ocaml.language_ocaml())
  assert_eq(language.name(), Some("ocaml"))
  assert_eq(language.abi_version(), 15)
  guard language.is_parseable() else {
    println("note: skipping ocaml: its external scanner is not ported yet")
    return
  }
  let parser = @treesitter.Parser::new()
  parser.set_language(language)
  let source =
    #|[@@@id]
    #|[@@@I.D]
    #|[@@@id let x = x]
    #|[@@@id:]
    #|[@@@id : t]
    #|[@@@id : type t type t]
    #|[@@@id ? A x]
    #|
  guard parser.parse(@utf8.encode(source)) is Some(tree) else {
    fail("parse failed")
  }
  let sexp = tree.root_node().to_sexp()
  assert_false(sexp.contains("ERROR") || sexp.contains("MISSING"), msg=sexp)
}

