test "language_typescript parses a sample" {
  let language = @tree_sitter_typescript.language_typescript()
  // Decoded once.
  assert_true(language == @tree_sitter_typescript.language_typescript())
  assert_eq(language.name(), Some("typescript"))
  assert_eq(language.abi_version(), 15)
  guard language.is_parseable() else {
    println("note: skipping typescript: its external scanner is not ported yet")
    return
  }
  let parser = @treesitter.Parser::new()
  parser.set_language(language)
  let source =
    #|try {}
    #|catch (e: unknown) {}
    #|finally {}
    #|
  guard parser.parse(@utf8.encode(source)) is Some(tree) else {
    fail("parse failed")
  }
  let sexp = tree.root_node().to_sexp()
  assert_false(sexp.contains("ERROR") || sexp.contains("MISSING"), msg=sexp)
}

