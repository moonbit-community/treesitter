///|
test "language parses a sample" {
  let language = @tree_sitter_make.language()
  // Decoded once.
  assert_true(language == @tree_sitter_make.language())
  assert_eq(language.name(), Some("make"))
  assert_eq(language.abi_version(), 15)
  let parser = @treesitter.Parser::new()
  parser.set_language(language)
  let source =
    #|ifeq ("string $(sort 1 2 3)", 'string ${VAR}')
    #|endif
    #|
    #|ifneq (arg0, arg1)
    #|endif
    #|
    #|ifdef var
    #|endif
    #|
    #|ifndef var
    #|endif
    #|
  guard parser.parse(@utf8.encode(source)) is Some(tree) else {
    fail("parse failed")
  }
  let sexp = tree.root_node().to_sexp()
  assert_false(sexp.contains("ERROR") || sexp.contains("MISSING"), msg=sexp)
}

///|
test "language queries compile" {
  let language = @tree_sitter_make.language()
  ignore(@treesitter.Query::new(language, @tree_sitter_make.highlights_query))
}

///|
test "node types" {
  assert_true(@tree_sitter_make.node_types.has_prefix("["))
}
