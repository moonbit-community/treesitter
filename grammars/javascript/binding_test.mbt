// Generated by tools/grammars/update.sh. Do not edit.

///|
test "language parses a sample" {
  let language = @tree_sitter_javascript.language()
  // Decoded once.
  assert_true(language == @tree_sitter_javascript.language())
  assert_eq(language.name(), Some("javascript"))
  assert_eq(language.abi_version(), 15)
  guard language.is_parseable() else {
    println("note: skipping javascript: its external scanner is not ported yet")
    return
  }
  let parser = @treesitter.Parser::new()
  parser.set_language(language)
  let source =
    #|({a, b: c.d, ...e[f]} = object);
    #|let {a, b, ...c} = object
    #|const {a, b: {c, d}} = object
    #|
  guard parser.parse(@utf8.encode(source)) is Some(tree) else {
    fail("parse failed")
  }
  let sexp = tree.root_node().to_sexp()
  assert_false(sexp.contains("ERROR") || sexp.contains("MISSING"), msg=sexp)
}

///|
test "language queries compile" {
  let language = @tree_sitter_javascript.language()
  ignore(
    @treesitter.Query::new(language, @tree_sitter_javascript.highlight_query),
  )
  ignore(
    @treesitter.Query::new(language, @tree_sitter_javascript.injections_query),
  )
  ignore(
    @treesitter.Query::new(
      language, @tree_sitter_javascript.jsx_highlight_query,
    ),
  )
  ignore(@treesitter.Query::new(language, @tree_sitter_javascript.locals_query))
  ignore(@treesitter.Query::new(language, @tree_sitter_javascript.tags_query))
}

///|
test "node types" {
  assert_true(@tree_sitter_javascript.node_types.has_prefix("["))
}
