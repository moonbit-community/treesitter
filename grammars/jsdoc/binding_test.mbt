///|
test "language parses a sample" {
  let language = @tree_sitter_jsdoc.language()
  // Decoded once.
  assert_true(language == @tree_sitter_jsdoc.language())
  assert_eq(language.name(), Some("jsdoc"))
  assert_eq(language.abi_version(), 15)
  guard language.is_parseable() else {
    println("note: skipping jsdoc: its external scanner is not ported yet")
    return
  }
  let parser = @treesitter.Parser::new()
  parser.set_language(language)
  let source =
    #|/** This is {something} that should not {error}. */
    #|
  guard parser.parse(@utf8.encode(source)) is Some(tree) else {
    fail("parse failed")
  }
  let sexp = tree.root_node().to_sexp()
  assert_false(sexp.contains("ERROR") || sexp.contains("MISSING"), msg=sexp)
}

///|
test "language queries compile" {
  let language = @tree_sitter_jsdoc.language()
  ignore(@treesitter.Query::new(language, @tree_sitter_jsdoc.highlights_query))
}

///|
test "node types" {
  assert_true(@tree_sitter_jsdoc.node_types.has_prefix("["))
}
