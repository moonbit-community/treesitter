///|
test "language parses a sample" {
  let language = @tree_sitter_zig.language()
  // Decoded once.
  assert_true(language == @tree_sitter_zig.language())
  assert_eq(language.name(), Some("zig"))
  assert_eq(language.abi_version(), 15)
  let parser = @treesitter.Parser::new()
  parser.set_language(language)
  let source =
    #|const std = @import("std");
    #|
    #|pub fn main() void {
    #|    std.debug.print("Hello, {s}!\n", .{"world"});
    #|}
    #|
  guard parser.parse(@utf8.encode(source)) is Some(tree) else {
    fail("parse failed")
  }
  let sexp = tree.root_node().to_sexp()
  assert_false(sexp.contains("ERROR") || sexp.contains("MISSING"), msg=sexp)
}

///|
test "language queries compile" {
  let language = @tree_sitter_zig.language()
  ignore(@treesitter.Query::new(language, @tree_sitter_zig.highlights_query))
  ignore(@treesitter.Query::new(language, @tree_sitter_zig.injections_query))
}

///|
test "node types" {
  assert_true(@tree_sitter_zig.node_types.has_prefix("["))
}
