///|
test "language parses a sample" {
  let language = @tree_sitter_cpp.language()
  // Decoded once.
  assert_true(language == @tree_sitter_cpp.language())
  assert_eq(language.name(), Some("cpp"))
  assert_eq(language.abi_version(), 15)
  guard language.is_parseable() else {
    println("note: skipping cpp: its external scanner is not ported yet")
    return
  }
  let parser = @treesitter.Parser::new()
  parser.set_language(language)
  let source =
    #|T1 a = b < c > d;
    #|T2 e = f<T3>(g);
    #|int a = std::get<0>(t);
    #|if (x.y < z) break; // Not a template missing a '>'
    #|if (x.y < x->y && x.y > 50) break;
    #|if (x.foo < 0 || bar >= 1) break;
    #|if (x.Base::foo < 0 || bar >= 1) {
    #|  bool i = x.Base::foo < 0 || 1 > (5); // No way to tell
    #|}
    #|
  guard parser.parse(@utf8.encode(source)) is Some(tree) else {
    fail("parse failed")
  }
  let sexp = tree.root_node().to_sexp()
  assert_false(sexp.contains("ERROR") || sexp.contains("MISSING"), msg=sexp)
}

///|
test "language queries compile" {
  let language = @tree_sitter_cpp.language()
  ignore(@treesitter.Query::new(language, @tree_sitter_cpp.highlight_query))
  ignore(@treesitter.Query::new(language, @tree_sitter_cpp.tags_query))
}

///|
test "node types" {
  assert_true(@tree_sitter_cpp.node_types.has_prefix("["))
}
