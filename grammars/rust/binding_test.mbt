///|
test "language parses a sample" {
  let language = @tree_sitter_rust.language()
  // Decoded once.
  assert_true(language == @tree_sitter_rust.language())
  assert_eq(language.name(), Some("rust"))
  assert_eq(language.abi_version(), 15)
  guard language.is_parseable() else {
    println("note: skipping rust: its external scanner is not ported yet")
    return
  }
  let parser = @treesitter.Parser::new()
  parser.set_language(language)
  let source =
    #|async fn abc() {}
    #|
    #|async fn main() {
    #|    let x = futures.await?;
    #|}
    #|
  guard parser.parse(@utf8.encode(source)) is Some(tree) else {
    fail("parse failed")
  }
  let sexp = tree.root_node().to_sexp()
  assert_false(sexp.contains("ERROR") || sexp.contains("MISSING"), msg=sexp)
}

///|
test "language queries compile" {
  let language = @tree_sitter_rust.language()
  ignore(@treesitter.Query::new(language, @tree_sitter_rust.highlights_query))
  ignore(@treesitter.Query::new(language, @tree_sitter_rust.injections_query))
  ignore(@treesitter.Query::new(language, @tree_sitter_rust.tags_query))
}

///|
test "node types" {
  assert_true(@tree_sitter_rust.node_types.has_prefix("["))
}
