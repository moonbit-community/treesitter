///|
test "language parses a sample" {
  let language = @tree_sitter_java.language()
  // Decoded once.
  assert_true(language == @tree_sitter_java.language())
  assert_eq(language.name(), Some("java"))
  assert_eq(language.abi_version(), 15)
  let parser = @treesitter.Parser::new()
  parser.set_language(language)
  let source =
    #|// This is a comment
    #|/* This is also a comment */
    #|/* this comment /* // /** ends here: */
    #|/**/
    #|
    #|a /* dkjfhsdf + */ + b; /* ***** */
    #|
  guard parser.parse(@utf8.encode(source)) is Some(tree) else {
    fail("parse failed")
  }
  let sexp = tree.root_node().to_sexp()
  assert_false(sexp.contains("ERROR") || sexp.contains("MISSING"), msg=sexp)
}

///|
test "language queries compile" {
  let language = @tree_sitter_java.language()
  ignore(@treesitter.Query::new(language, @tree_sitter_java.highlights_query))
  ignore(@treesitter.Query::new(language, @tree_sitter_java.tags_query))
}

///|
test "node types" {
  assert_true(@tree_sitter_java.node_types.has_prefix("["))
}
