///|
test "language parses a sample" {
  let language = @tree_sitter_go.language()
  // Decoded once.
  assert_true(language == @tree_sitter_go.language())
  assert_eq(language.name(), Some("go"))
  assert_eq(language.abi_version(), 15)
  let parser = @treesitter.Parser::new()
  parser.set_language(language)
  let source =
    #|package main
    #|
    #|const zero = 0
    #|const one, two = 1, 2
    #|const three, four, five = 3, 4, 5
    #|
  guard parser.parse(@utf8.encode(source)) is Some(tree) else {
    fail("parse failed")
  }
  let sexp = tree.root_node().to_sexp()
  assert_false(sexp.contains("ERROR") || sexp.contains("MISSING"), msg=sexp)
}

///|
test "language queries compile" {
  let language = @tree_sitter_go.language()
  ignore(@treesitter.Query::new(language, @tree_sitter_go.highlights_query))
  ignore(@treesitter.Query::new(language, @tree_sitter_go.tags_query))
}

///|
test "node types" {
  assert_true(@tree_sitter_go.node_types.has_prefix("["))
}
