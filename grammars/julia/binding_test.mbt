// Generated by tools/grammars/update.sh. Do not edit.

///|
test "language parses a sample" {
  let language = @tree_sitter_julia.language()
  // Decoded once.
  assert_true(language == @tree_sitter_julia.language())
  assert_eq(language.name(), Some("julia"))
  assert_eq(language.abi_version(), 15)
  guard language.is_parseable() else {
    println("note: skipping julia: its external scanner is not ported yet")
    return
  }
  let parser = @treesitter.Parser::new()
  parser.set_language(language)
  let source =
    #|()
    #|# There's no (,)
    #|
    #|(1) # NOT a tuple
    #|(1,)
    #|(2,3,4,)
    #|
  guard parser.parse(@utf8.encode(source)) is Some(tree) else {
    fail("parse failed")
  }
  let sexp = tree.root_node().to_sexp()
  assert_false(sexp.contains("ERROR") || sexp.contains("MISSING"), msg=sexp)
}

///|
test "language queries compile" {
  let language = @tree_sitter_julia.language()
  ignore(@treesitter.Query::new(language, @tree_sitter_julia.highlights_query))
  ignore(@treesitter.Query::new(language, @tree_sitter_julia.injections_query))
  ignore(@treesitter.Query::new(language, @tree_sitter_julia.locals_query))
}

///|
test "node types" {
  assert_true(@tree_sitter_julia.node_types.has_prefix("["))
}
