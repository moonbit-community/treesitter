///|
test "language_php parses a sample" {
  let language = @tree_sitter_php.language_php()
  // Decoded once.
  assert_true(language == @tree_sitter_php.language_php())
  assert_eq(language.name(), Some("php"))
  assert_eq(language.abi_version(), 15)
  guard language.is_parseable() else {
    println("note: skipping php: its external scanner is not ported yet")
    return
  }
  let parser = @treesitter.Parser::new()
  parser.set_language(language)
  let source =
    #|<?php
    #|define('self', 'value');
    #|var_dump(self);
    #|
  guard parser.parse(@utf8.encode(source)) is Some(tree) else {
    fail("parse failed")
  }
  let sexp = tree.root_node().to_sexp()
  assert_false(sexp.contains("ERROR") || sexp.contains("MISSING"), msg=sexp)
}

