///|
test "language parses a sample" {
  let language = @tree_sitter_markdown.language()
  // Decoded once.
  assert_true(language == @tree_sitter_markdown.language())
  assert_eq(language.name(), Some("markdown"))
  assert_eq(language.abi_version(), 15)
  guard language.is_parseable() else {
    println("note: skipping markdown: its external scanner is not ported yet")
    return
  }
  let parser = @treesitter.Parser::new()
  parser.set_language(language)
  let source =
    #|| foo | bar |
    #|| --- | --- |
    #|| baz | bim |
    #|
  guard parser.parse(@utf8.encode(source)) is Some(tree) else {
    fail("parse failed")
  }
  let sexp = tree.root_node().to_sexp()
  assert_false(sexp.contains("ERROR") || sexp.contains("MISSING"), msg=sexp)
}

///|
test "inline_language parses a sample" {
  let language = @tree_sitter_markdown.inline_language()
  // Decoded once.
  assert_true(language == @tree_sitter_markdown.inline_language())
  assert_eq(language.name(), Some("markdown_inline"))
  assert_eq(language.abi_version(), 15)
  guard language.is_parseable() else {
    println(
      "note: skipping markdown_inline: its external scanner is not ported yet",
    )
    return
  }
  let parser = @treesitter.Parser::new()
  parser.set_language(language)
  let source =
    #|$$This$$ has $$an odd$$ number of instances of $$.
    #|
  guard parser.parse(@utf8.encode(source)) is Some(tree) else {
    fail("parse failed")
  }
  let sexp = tree.root_node().to_sexp()
  assert_false(sexp.contains("ERROR") || sexp.contains("MISSING"), msg=sexp)
}

