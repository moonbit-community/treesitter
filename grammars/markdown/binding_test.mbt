test "language queries compile" {
  let language = @tree_sitter_markdown.language()
  ignore(
    @treesitter.Query::new(
      language, @tree_sitter_markdown.highlight_query_block,
    ),
  )
  ignore(
    @treesitter.Query::new(
      language, @tree_sitter_markdown.injection_query_block,
    ),
  )
}

