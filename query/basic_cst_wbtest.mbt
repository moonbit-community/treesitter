// The tables of the `basic_cst` test grammar (tests/testdata/basic_cst.json),
// for white-box tests that need a language on every backend.

///|
let basic_cst_json : String =
  #|{"abi_version": 15, "symbol_count": 6, "alias_count": 0, "token_count": 4, "external_token_count": 0, "state_count": 7, "large_state_count": 2, "production_id_count": 2, "field_count": 2, "max_alias_sequence_length": 3, "parse_table": [1, 1, 1, 1, 0, 0, 0, 0, 3, 0, 3, 4], "small_parse_table": [1, 5, 1, 1, 1, 7, 1, 0, 1, 9, 1, 0, 1, 11, 1, 3, 1, 13, 1, 0], "small_parse_table_map": [0, 4, 8, 12, 16], "parse_actions": [["Entry", {"count": 0, "reusable": false}], ["Entry", {"count": 1, "reusable": false}], "Recover", ["Entry", {"count": 1, "reusable": true}], ["Shift", {"state": 2, "extra": false, "repetition": false}], ["Entry", {"count": 1, "reusable": true}], ["Shift", {"state": 5, "extra": false, "repetition": false}], ["Entry", {"count": 1, "reusable": true}], "Accept", ["Entry", {"count": 1, "reusable": true}], ["Reduce", {"symbol": 4, "child_count": 1, "dynamic_precedence": 0, "production_id": 0}], ["Entry", {"count": 1, "reusable": true}], ["Shift", {"state": 6, "extra": false, "repetition": false}], ["Entry", {"count": 1, "reusable": true}], ["Reduce", {"symbol": 5, "child_count": 3, "dynamic_precedence": 0, "production_id": 1}]], "symbol_names": ["end", "=", "identifier", "number", "document", "assignment"], "field_names": ["", "name", "value"], "field_map_slices": [{"index": 0, "length": 0}, {"index": 0, "length": 2}], "field_map_entries": [{"field_id": 1, "child_index": 0, "inherited": false}, {"field_id": 2, "child_index": 2, "inherited": false}], "symbol_metadata": [{"visible": false, "named": true, "supertype": false}, {"visible": true, "named": false, "supertype": false}, {"visible": true, "named": true, "supertype": false}, {"visible": true, "named": true, "supertype": false}, {"visible": true, "named": true, "supertype": false}, {"visible": true, "named": true, "supertype": false}], "public_symbol_map": [0, 1, 2, 3, 4, 5], "alias_map": [0], "alias_sequences": [0, 0, 0, 0, 0, 0], "lex_modes": [{"lex_state": 0, "external_lex_state": 0, "reserved_word_set_id": 0}, {"lex_state": 0, "external_lex_state": 0, "reserved_word_set_id": 0}, {"lex_state": 0, "external_lex_state": 0, "reserved_word_set_id": 0}, {"lex_state": 0, "external_lex_state": 0, "reserved_word_set_id": 0}, {"lex_state": 0, "external_lex_state": 0, "reserved_word_set_id": 0}, {"lex_state": 0, "external_lex_state": 0, "reserved_word_set_id": 0}, {"lex_state": 0, "external_lex_state": 0, "reserved_word_set_id": 0}], "keyword_capture_token": 0, "external_scanner": {"states": [], "symbol_map": []}, "primary_state_ids": [0, 1, 2, 3, 4, 5, 6], "name": "basic_cst", "reserved_words": [], "max_reserved_word_set_size": 0, "supertype_count": 0, "supertype_symbols": [], "supertype_map_slices": [], "supertype_map_entries": [], "metadata": {"major_version": 0, "minor_version": 0, "patch_version": 0}, "lex_fn": {"states": [{"eof_advance": 1, "advance_map": [], "transitions": [{"condition": {"asserted": {"ranges": [{"start": 61, "end": 61}], "is_included": true}}, "state": 2, "skip": false}, {"condition": {"asserted": {"ranges": [{"start": 9, "end": 13}, {"start": 32, "end": 32}], "is_included": true}}, "state": 0, "skip": true}, {"condition": {"asserted": {"ranges": [{"start": 48, "end": 57}], "is_included": true}}, "state": 4, "skip": false}, {"condition": {"asserted": {"ranges": [{"start": 97, "end": 122}], "is_included": true}}, "state": 3, "skip": false}]}, {"accept_token": 0, "advance_map": [], "transitions": []}, {"accept_token": 1, "advance_map": [], "transitions": []}, {"accept_token": 2, "advance_map": [], "transitions": [{"condition": {"asserted": {"ranges": [{"start": 97, "end": 122}], "is_included": true}}, "state": 3, "skip": false}]}, {"accept_token": 3, "advance_map": [], "transitions": [{"condition": {"asserted": {"ranges": [{"start": 48, "end": 57}], "is_included": true}}, "state": 4, "skip": false}]}], "large_character_sets": []}}

///|
fn basic_cst() -> @language.Language {
  @json.from_json(@json.parse(basic_cst_json)) catch {
    e => abort("basic_cst: \{e}")
  }
}
