///|
/// Emit a standalone MoonBit language factory. The generated package needs
/// only the language package and its lexer data, not the grammar generator.
pub fn emit(language : @language.Language) -> String {
  let encoded = Json(language).stringify()
  "///|\n// Generated by bobzhang/treesitter. Do not edit.\npub fn language() -> @language.Language raise {\n  @language.Language::parse(\n    #|\{encoded}\n  )\n}\n"
}
