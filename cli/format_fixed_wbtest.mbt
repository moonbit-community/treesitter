///|
test "format_fixed matches Rust's {:.2} and {:.3}" {
  let mismatches = []
  for case in format_fixed_cases {
    let (bits, two, three) = case
    let x = bits.reinterpret_as_double()
    if format_fixed2(x) != two || format_fixed3(x) != three {
      mismatches.push("\{bits}: \{format_fixed2(x)} \{format_fixed3(x)}")
    }
  }
  inspect(mismatches.join("\n"), content="")
  inspect(format_fixed2(1.0 / 32.0 * 100.0), content="3.12")
  inspect(format_fixed(2.5, 0), content="2")
  inspect(format_fixed(-0.5, 0), content="-0")
}

