  if c <= HS_BITMAP_VARID_START_2_MAX_CODEPOINT {
    return hs_is_varid_start_2_char(c)
  }
  if c < HS_BITMAP_VARID_START_3_MIN_CODEPOINT {
    return false
  }
  if c <= HS_BITMAP_VARID_START_3_MAX_CODEPOINT {
    return hs_is_varid_start_3_char(c)
  }
  if c < HS_BITMAP_VARID_START_4_MIN_CODEPOINT {
    return false
  }
  if c <= HS_BITMAP_VARID_START_4_MAX_CODEPOINT {
    return hs_is_varid_start_4_char(c)
  }
  false
}

