///|
const HS_BITMAP_SPACE_MIN_CODEPOINT : Int32 = 32

///|
const HS_BITMAP_SPACE_MAX_CODEPOINT : Int32 = 12288

///|
fn hs_is_space_char(c : Int32) -> Bool {
  if c < HS_BITMAP_SPACE_MIN_CODEPOINT || c > HS_BITMAP_SPACE_MAX_CODEPOINT {
    return false
  }
  let offset = c - HS_BITMAP_SPACE_MIN_CODEPOINT
  (hs_bitmap_space[offset >> 3].to_int() & (1 << (offset & 7))) > 0
}

///|
fn hs_is_identifier_char(c : Int32) -> Bool {
  if c < HS_BITMAP_IDENTIFIER_1_MIN_CODEPOINT {
    return false
  }
  if c <= HS_BITMAP_IDENTIFIER_1_MAX_CODEPOINT {
    return hs_is_identifier_1_char(c)
  }
  if c < HS_BITMAP_IDENTIFIER_2_MIN_CODEPOINT {
    return false
  }
  if c <= HS_BITMAP_IDENTIFIER_2_MAX_CODEPOINT {
    return hs_is_identifier_2_char(c)
  }
  if c < HS_BITMAP_IDENTIFIER_3_MIN_CODEPOINT {
    return false
  }
  if c <= HS_BITMAP_IDENTIFIER_3_MAX_CODEPOINT {
    return hs_is_identifier_3_char(c)
  }
  if c < HS_BITMAP_IDENTIFIER_4_MIN_CODEPOINT {
    return false
  }
  if c <= HS_BITMAP_IDENTIFIER_4_MAX_CODEPOINT {
    return hs_is_identifier_4_char(c)
  }
  if c < HS_BITMAP_IDENTIFIER_5_MIN_CODEPOINT {
    return false
  }
  if c <= HS_BITMAP_IDENTIFIER_5_MAX_CODEPOINT {
    return hs_is_identifier_5_char(c)
  }
  false
}

